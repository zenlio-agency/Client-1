---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HeroDetail from "@/components/content/HeroDetail.astro";
import HubCards from "@/components/content/HubCards.astro";
import GlobalPresence from "@/components/content/GlobalPresence.astro";
import ProcessSteps from "@/components/content/ProcessSteps.astro";
import FaqList from "@/components/content/FaqList.astro";
import CtaFinal from "@/components/content/CtaFinal.astro";
import { CTA } from "@/data/site.ts";
import { LOCATIONS_PHOTO } from "@/data/photos.ts";
---

<Layout
  title="Locations"
  description="ManyaIT works from two hubs: a Client & Leadership Hub in Dallas, Texas, and an Engineering & Talent Hub in Hyderabad, India."
>
  {/* Hero */}
  <Section paddingTop="small">
    <HeroDetail
      crumbs={[{ label: "Home", href: "/" }, { label: "Locations" }]}
      eyebrow="Global presence"
      title="Two cities. One team. Around the clock."
      lede="Client leadership in Dallas, engineering depth in Hyderabad. Together they give enterprises a partner in their own time zone and teams that keep work moving while North America sleeps."
      points={["Dallas, Texas", "Hyderabad, India", "Daily overlap hours"]}
      primary={CTA.primary}
      secondary={{ label: "View opportunities", href: "/careers" }}
      photo={LOCATIONS_PHOTO}
    />
  </Section>

  {/* Hubs */}
  <Section theme="tint" id="hubs">
    <HubCards />
  </Section>

  {/* Map */}
  <Section id="map">
    <GlobalPresence />
  </Section>

  {/* How the day hands over */}
  <Section theme="dark" id="handover">
    <ProcessSteps
      eyebrow="Follow the sun"
      heading="A working day that hands over instead of stopping"
      intro="Two hubs, more than ten hours apart, run as one team with one plan."
      steps={[
        {
          title: "Overlap hours",
          text: "Every working day starts with shared hours, Dallas morning and Hyderabad evening, for stand-ups, reviews and decisions.",
          note: "Daily overlap",
        },
        {
          title: "Build while you sleep",
          text: "Hyderabad teams build, test and release against the priorities agreed in the overlap, while North America is offline.",
          note: "Work keeps moving",
        },
        {
          title: "Ready by morning",
          text: "Your teams start the day with finished work, test results and a written handover, not a queue of questions.",
          note: "Clear handovers",
        },
        {
          title: "Support that follows the sun",
          text: "Priority incidents go to whichever hub is awake, with runbooks and on-call rotations shared across both.",
          note: "Round-the-clock cover",
        },
      ]}
    />
  </Section>

  {/* FAQ */}
  <Section>
    <FaqList
      heading="Locations, answered"
      items={[
        {
          question: "What does each hub do?",
          answer:
            "Dallas is our Client & Leadership Hub: it shapes each team with enterprise leaders and keeps the plan on track in North American hours. Hyderabad is our Engineering & Talent Hub, home to the engineers who build, run and improve the platforms.",
        },
        {
          question: "Do you work with enterprises outside North America?",
          answer:
            "Yes. Hyderabad teams work with enterprises worldwide, and overlap hours are set around each enterprise's own time zone.",
        },
        {
          question: "How do two locations keep to one standard?",
          answer:
            "One plan, shared tooling, the same engineering standards and leads who spend time in both cities. Each team is measured on the same outcomes, wherever its people sit.",
        },
        {
          question: "Can we visit the teams?",
          answer:
            "Yes. Enterprise leaders are welcome at both hubs, and many teams plan regular visits so people meet in person.",
        },
      ]}
    />
  </Section>

  {/* Final CTA */}
  <Section theme="dark" paddingTop="large">
    <CtaFinal />
  </Section>
</Layout>
