---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ArticleHeader from "@/components/content/ArticleHeader.astro";
import ArticleBody from "@/components/content/ArticleBody.astro";
import RelatedTiles from "@/components/content/RelatedTiles.astro";
import { SITE_NAME } from "@/consts.ts";
import { insightHref } from "@/utils/insights.ts";
import { articles, type Article } from "@/sanity/content.ts";

export async function getStaticPaths() {
  const all = await articles();
  return all.map((article) => ({
    params: { slug: article.id },
    props: {
      article,
      others: all.filter((other) => other.id !== article.id),
    },
  }));
}

type Props = {
  article: Article;
  others: Article[];
};

const { article, others } = Astro.props;

/* Article structured data for search engines. The publish date is left out
   until it is a real date. */
const published = /^\d{4}-\d{2}-\d{2}$/.test(article.published)
  ? article.published
  : undefined;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.title,
  description: article.description,
  image: new URL(article.photo.src, Astro.site).href,
  ...(published && { datePublished: published }),
  author: { "@type": "Organization", name: SITE_NAME },
  publisher: { "@type": "Organization", name: SITE_NAME },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Layout title={article.title} description={article.description} type="article">
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  {/* Header and photo */}
  <Section paddingTop="small" paddingBottom="none">
    <ArticleHeader
      title={article.title}
      summary={article.summary}
      category={article.category}
      type={article.type}
      author={article.author}
      published={article.published}
      minutes={article.minutes}
      photo={article.photo.src}
    />
  </Section>

  {/* The article */}
  <Section paddingTop="small">
    <ArticleBody article={article} />
  </Section>

  {/* More articles */}
  <Section theme="tint">
    <RelatedTiles
      eyebrow="Keep reading"
      heading="More insights"
      link={{ label: "All insights", href: "/insights" }}
      items={others.slice(0, 3).map((other) => ({
        title: other.title,
        text: other.summary,
        href: insightHref(other),
        photo: other.photo.src,
      }))}
    />
  </Section>
</Layout>
