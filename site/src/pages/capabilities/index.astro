---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HeroDetail from "@/components/content/HeroDetail.astro";
import FeatureGrid from "@/components/content/FeatureGrid.astro";
import ProcessSteps from "@/components/content/ProcessSteps.astro";
import FaqList from "@/components/content/FaqList.astro";
import CtaFinal from "@/components/content/CtaFinal.astro";
import { CAPABILITIES, CTA, TEAM_STEPS, capabilityHref } from "@/data/site.ts";
import { CAPABILITY_PHOTOS } from "@/data/photos.ts";
---

<Layout
  title="Capabilities | ManyaIT: Data, AI, SAP & Digital Engineering"
  description="End-to-end data, AI, SAP, automation and digital product engineering, from strategy and architecture to delivery and continuous optimization."
>
  {/* Hero */}
  <Section paddingTop="small">
    <HeroDetail
      crumbs={[{ label: "Home", href: "/" }, { label: "Capabilities" }]}
      eyebrow="Capabilities"
      title="End-to-end engineering across the modern enterprise stack."
      lede="Five integrated capability areas, one accountable delivery model. From strategy and architecture to build, deployment and continuous optimization, our teams turn complex technology agendas into measurable business outcomes."
      points={[
        "Strategy to production",
        "Expert-led teams",
        "Flexible engagement models",
      ]}
      primary={{ label: "Discuss your initiative", href: CTA.primary.href }}
      secondary={{ label: "Why ManyaIT", href: "/about" }}
      photo={CAPABILITY_PHOTOS["cap-data"]}
    />
  </Section>

  {/* The five capabilities, each with its focus areas */}
  <Section theme="tint">
    <FeatureGrid
      variant="rows"
      eyebrow="What we deliver"
      heading="Integrated capabilities for data-driven, AI-ready enterprises"
      intro="Start with one capability or combine them into a single program. Data fuels AI, enterprise platforms anchor data, and digital products bring it all to your customers. One partner can carry the work across every layer."
      items={CAPABILITIES.map((cap) => ({
        title: cap.title,
        text: cap.line,
        list: [...cap.focus],
        href: capabilityHref(cap),
        icon: cap.icon,
      }))}
      linkLabel="Explore"
    />
  </Section>

  {/* Engagement models */}
  <Section>
    <FeatureGrid
      eyebrow="Engagement models"
      heading="Engage the way your organization works best."
      intro="Every enterprise moves differently. Choose the model that fits your goals today, and change it as your priorities evolve."
      columns={4}
      numbered
      items={[
        {
          title: "Advisory & assessment",
          text: "Focused engagements to assess your data, platforms and AI readiness, and define a prioritized roadmap with clear business cases.",
        },
        {
          title: "End-to-end delivery",
          text: "We own a defined scope from discovery to deployment and support, against agreed milestones, quality gates and service levels.",
        },
        {
          title: "Dedicated engineering teams",
          text: "Expert engineers who integrate with your teams, tools and processes, and scale up or down as your roadmap changes.",
        },
        {
          title: "Build, run & transition",
          text: "We build and operate a dedicated delivery hub for you, then transition the people, processes and knowledge to your organization on your timeline.",
        },
      ]}
    />
  </Section>

  {/* How an engagement runs */}
  <Section theme="dark">
    <ProcessSteps
      eyebrow="How it works"
      heading="From first conversation to lasting impact"
      intro="Every capability follows the same accountable path, whether it starts with a focused assessment or a full-scale transformation program."
      steps={TEAM_STEPS}
    />
  </Section>

  {/* FAQ */}
  <Section>
    <FaqList
      heading="Capabilities, answered"
      intro="Can't find what you're looking for? Ask us directly."
      items={[
        {
          question: "Can one team cover more than one capability?",
          answer:
            "Yes. Many programs combine data engineering with AI, or SAP with analytics and automation. We design the team around the outcome and add specialists as the scope evolves.",
        },
        {
          question: "Do you work on our existing platforms and tools?",
          answer:
            "Almost always. Our teams work inside your repositories, cloud environments, toolchains and controls, building on what already works rather than starting over.",
        },
        {
          question: "Can you take ownership of a complete project?",
          answer:
            "Yes. We can own delivery end to end, from discovery and architecture to build, testing, deployment and support, with clear milestones, governance and reporting.",
        },
        {
          question: "How quickly can we get started?",
          answer:
            "Work can begin as soon as the scope is agreed, with a core team starting first while the wider team ramps up.",
        },
        {
          question: "How do you make AI and data solutions enterprise-ready?",
          answer:
            "We build on governed, high-quality data, apply security and responsible-AI controls from the start, and put monitoring, MLOps and clear ownership in place so solutions perform reliably in production.",
        },
      ]}
    />
  </Section>

  {/* Final CTA */}
  <Section theme="dark" paddingTop="large">
    <CtaFinal />
  </Section>
</Layout>
