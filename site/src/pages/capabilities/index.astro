---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HeroDetail from "@/components/content/HeroDetail.astro";
import FeatureGrid from "@/components/content/FeatureGrid.astro";
import TeamPanel from "@/components/content/TeamPanel.astro";
import FaqList from "@/components/content/FaqList.astro";
import CtaFinal from "@/components/content/CtaFinal.astro";
import { CAPABILITIES, CTA, capabilityHref } from "@/data/site.ts";
import { CAPABILITY_PHOTOS } from "@/data/photos.ts";
---

<Layout
  title="Capabilities: Data, AI, SAP & Product Engineering | ManyaIT"
  description="End-to-end data, AI, SAP, automation and digital product engineering, from strategy and architecture to delivery and managed operations."
>
  {/* Hero */}
  <Section paddingTop="small">
    <HeroDetail
      crumbs={[{ label: "Home", href: "/" }, { label: "Capabilities" }]}
      eyebrow="Capabilities"
      title="End-to-end engineering across the modern enterprise stack."
      lede="Integrated capabilities, one accountable delivery model. From strategy and architecture to build, release and continuous optimization, our teams turn complex technology agendas into measurable business outcomes."
      points={[
        "Strategy to production",
        "Senior-led, cross-functional teams",
        "Flexible operating models",
      ]}
      primary={{ label: "Discuss your initiative", href: CTA.primary.href }}
      secondary={{ label: "Why ManyaIT", href: "/about" }}
      photo={CAPABILITY_PHOTOS["cap-data"]}
    />
  </Section>

  {/* The five capabilities, each with its focus areas */}
  <Section theme="tint">
    <FeatureGrid
      variant="rows"
      eyebrow="What we deliver"
      heading="Integrated capabilities for data-driven, AI-ready enterprises"
      intro="Start with one capability or combine them into a single program. Data fuels AI, enterprise platforms anchor data, and digital products put it in front of customers. One partner carries the work across every layer."
      items={CAPABILITIES.map((cap) => ({
        title: cap.heading,
        descriptor: cap.descriptor,
        text: cap.line,
        list: [...cap.focus],
        href: capabilityHref(cap),
        icon: cap.icon,
      }))}
      linkLabel="Explore"
    />
  </Section>

  {/* Operating models */}
  <Section>
    <FeatureGrid
      eyebrow="Operating models"
      heading="Work with us the way your organization runs."
      intro="Every enterprise moves differently. Choose the model that fits your objectives today, and change it as priorities evolve."
      columns={4}
      numbered
      items={[
        {
          title: "Strategy & readiness assessment",
          text: "A time-boxed assessment of your architecture, data and AI readiness, ending in a prioritized roadmap and business cases leadership can fund.",
        },
        {
          title: "Outcome-based delivery",
          text: "We own a defined scope from discovery to deployment and hypercare, against agreed milestones, quality gates and service levels.",
        },
        {
          title: "Product & platform teams",
          text: "Persistent, cross-functional teams that own a product or platform roadmap, integrate with your engineering organization and scale with demand.",
        },
        {
          title: "Managed operations",
          text: "We run, monitor and optimize platforms in production under agreed service levels, and transfer operations and knowledge to your teams whenever you choose.",
        },
      ]}
    />
  </Section>

  {/* The team behind the work */}
  <Section theme="tint" id="team">
    <TeamPanel
      eyebrow="Team behind the work"
      heading="Senior talent, organized around outcomes."
      text="Every program is led by an accountable delivery lead and an architect, with engineers, data specialists and domain leads mobilized around your roadmap. The same team stays with the work, so knowledge compounds instead of resetting."
      points={[
        "Architects accountable for every program",
        "Specialists mobilized to the roadmap",
        "Continuity from first sprint to steady state",
      ]}
    />
  </Section>

  {/* FAQ */}
  <Section>
    <FaqList
      heading="Capabilities, answered"
      intro="Can't find what you're looking for? Ask us directly."
      items={[
        {
          question: "Can one team cover more than one capability?",
          answer:
            "Yes. Many programs combine data engineering with AI, or SAP with analytics and automation. We shape one cross-functional team around the outcome and bring in deeper platform expertise as the scope evolves.",
        },
        {
          question: "Can your teams work inside our engineering organization?",
          answer:
            "Yes. Our teams work inside your repositories, toolchains and ceremonies, follow your definition of done and report through your governance, while ManyaIT stays accountable for delivery quality and continuity.",
        },
        {
          question: "Do you work on our existing platforms and tools?",
          answer:
            "Almost always. We build on what already works inside your cloud environments, toolchains and controls rather than starting over.",
        },
        {
          question: "Can you take ownership of a complete program?",
          answer:
            "Yes. We own delivery end to end, from discovery and architecture to build, testing, deployment and support, with clear milestones, governance and reporting.",
        },
        {
          question: "How quickly can we get started?",
          answer:
            "Work can begin as soon as the scope is agreed. Discovery starts first, led by an architect and a delivery lead, while the full team mobilizes.",
        },
        {
          question: "How do you make AI and data solutions enterprise-ready?",
          answer:
            "We build on governed, high-quality data, apply security and responsible-AI controls from the start, and put evaluation, monitoring and clear ownership in place so solutions perform reliably in production.",
        },
      ]}
    />
  </Section>

  {/* Final CTA */}
  <Section theme="dark" paddingTop="large">
    <CtaFinal />
  </Section>
</Layout>
