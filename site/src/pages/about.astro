---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HeroDetail from "@/components/content/HeroDetail.astro";
import StorySplit from "@/components/content/StorySplit.astro";
import FeatureGrid from "@/components/content/FeatureGrid.astro";
import ProcessSteps from "@/components/content/ProcessSteps.astro";
import GlobalPresence from "@/components/content/GlobalPresence.astro";
import FaqList from "@/components/content/FaqList.astro";
import CtaFinal from "@/components/content/CtaFinal.astro";
import { CTA, TEAM_STEPS } from "@/data/site.ts";
import { ABOUT_PHOTOS } from "@/data/photos.ts";
---

<Layout
  title="About ManyaIT | Technology, Data & AI Engineering Partner"
  description="ManyaIT is a technology, data and AI engineering partner helping enterprises design, build and run modern platforms, from strategy to production."
>
  {/* Hero */}
  <Section paddingTop="small">
    <HeroDetail
      crumbs={[{ label: "Home", href: "/" }, { label: "About" }]}
      eyebrow="About ManyaIT"
      title="Engineering what your enterprise needs next."
      lede="ManyaIT is a technology and talent partner that turns strategy into production-ready platforms. We bring together expert engineers, proven delivery frameworks and deep domain context to design, build, modernize and run the systems that move your business forward."
      points={[
        "End-to-end delivery",
        "Expert engineering talent",
        "Outcomes that last",
      ]}
      primary={CTA.primary}
      secondary={{ label: "Explore capabilities", href: "/capabilities" }}
      photo={ABOUT_PHOTOS.hero}
    />
  </Section>

  {/* Story */}
  <Section theme="tint" id="story">
    <StorySplit
      eyebrow="Our story"
      heading="From IT solutions to end-to-end engineering partner."
      paragraphs={[
        "ManyaIT began as a technology solutions firm headquartered in the United States, with an engineering office in India.",
        "Years of delivering mobility, cloud and big data programs taught us a simple truth: transformation succeeds when strategy, engineering and the right people move as one. Architecture alone does not ship. Talent alone does not scale. Lasting outcomes come from bringing both together, with clear ownership from the first workshop to the final release.",
        "Today, enterprises partner with us across the full technology lifecycle, from data foundations and enterprise platforms to applied AI, intelligent automation and digital products. Some engage us to deliver a defined program end to end. Others extend their own engineering organization with our specialists, or build a long-term delivery hub with us. Every engagement is measured the same way: by the business outcomes it creates and the capability it leaves behind.",
      ]}
      points={[
        { title: "United States", text: "Client & Leadership Hub" },
        { title: "India", text: "Engineering & Talent Hub" },
      ]}
      photo={ABOUT_PHOTOS.story}
      reverse
    />
  </Section>

  {/* Mission and vision */}
  <Section id="why">
    <FeatureGrid
      eyebrow="Why we exist"
      heading="Strategy to production. People to platforms."
      intro="Enterprises don't need more vendors. They need one accountable partner that can think, build and run."
      columns={2}
      items={[
        {
          title: "Our mission",
          text: "To help enterprises build technology that delivers measurable value: engineered with precision, delivered end to end and powered by people who take ownership of the outcome.",
        },
        {
          title: "Our vision",
          text: "To be the most trusted engineering partner for enterprises modernizing with data and AI, known for platforms that perform in production and teams that raise the bar every quarter.",
        },
      ]}
    />
  </Section>

  {/* Values */}
  <Section theme="tint" id="values">
    <FeatureGrid
      eyebrow="What we believe"
      heading="The principles behind every engagement"
      intro="They shape who joins ManyaIT, how we partner with every enterprise and what we expect of ourselves."
      numbered
      items={[
        {
          title: "Outcomes over output",
          text: "We measure success by business impact, not by hours logged or tickets closed.",
        },
        {
          title: "Engineering excellence",
          text: "Clean architecture, tested code and documented decisions, built to perform at enterprise scale.",
        },
        {
          title: "Transparency by default",
          text: "Clear reporting, early visibility of risk and honest recommendations, even when the news is hard.",
        },
        {
          title: "Continuity and ownership",
          text: "Teams that stay learn your systems, your domain and your controls. Knowledge compounds instead of walking out the door.",
        },
        {
          title: "Security by design",
          text: "Governance, privacy and compliance are built into every sprint, not added at audit time.",
        },
        {
          title: "Two hubs, one standard",
          text: "Our US and India hubs work to one plan and one quality bar, so delivery moves forward around the clock.",
        },
      ]}
    />
  </Section>

  {/* Model */}
  <Section theme="dark" id="model">
    <ProcessSteps
      eyebrow="How we work"
      heading="From vision to value, end to end."
      intro="One accountable lifecycle, from the first conversation to a platform that runs and keeps improving, with the flexibility to engage at any stage."
      steps={TEAM_STEPS}
    />
  </Section>

  {/* Locations */}
  <Section id="locations">
    <GlobalPresence />
  </Section>

  {/* FAQ */}
  <Section theme="tint">
    <FaqList
      heading="About ManyaIT, answered"
      intro="Can't find what you're looking for? Ask us directly."
      items={[
        {
          question: "What does ManyaIT do?",
          answer:
            "ManyaIT is a technology, data and AI engineering partner. We help enterprises design, build, modernize and run critical platforms across data and analytics, SAP and enterprise data, applied AI, intelligent automation and digital product engineering, with expert teams and end-to-end delivery ownership.",
        },
        {
          question: "How can we work with ManyaIT?",
          answer:
            "Every engagement is shaped around your goals. We can deliver a defined program end to end, embed specialist engineers within your existing teams, or build and run a dedicated delivery hub that scales with your roadmap, with the option to transition it fully to your organization when you're ready.",
        },
        {
          question: "Can you take a project from strategy to production?",
          answer:
            "Yes. We cover the full lifecycle: assessment, roadmap, architecture, engineering, testing, deployment and ongoing operations, with one accountable team and clear governance throughout.",
        },
        {
          question: "How do you ensure quality and security?",
          answer:
            "Engineering standards, code reviews, automated testing and DevSecOps practices are built into every sprint. Our teams work within your security, privacy and compliance controls and report against the measures you define.",
        },
        {
          question: "Where are you based?",
          answer:
            "Our Client & Leadership Hub is in the United States, and our Engineering & Talent Hub is in India. Teams work across both, with daily overlap in North American business hours.",
        },
        {
          question: "Which industries do you serve?",
          answer:
            "Banking and financial services, telecommunications, healthcare and energy. Our teams understand the regulations, systems and operating pressures of each sector.",
        },
      ]}
    />
  </Section>

  {/* Final CTA */}
  <Section theme="dark" paddingTop="large">
    <CtaFinal />
  </Section>
</Layout>
