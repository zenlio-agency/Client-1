---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import CareersOpenings from "@/components/content/CareersOpenings.astro";
import GlobalPresence from "@/components/content/GlobalPresence.astro";
---

<Layout
  title="Careers"
  description="Build systems that matter. Work on enterprise platforms millions of people rely on, with mentors, certifications and a clear path to grow."
>
  {/* Openings */}
  <Section paddingTop="small" id="careers">
    <CareersOpenings />
  </Section>

  {/* Locations */}
  <Section theme="tint" id="locations">
    <GlobalPresence actions={false} />
  </Section>
</Layout>
