---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import IndustryDetail from "@/components/content/IndustryDetail.astro";
import CtaFinal from "@/components/content/CtaFinal.astro";
---

<Layout
  title="Industries"
  description="Technology, data and AI engineering for banking, telecommunications, healthcare, energy and retail, shaped by each sector's regulation and core systems."
>
  {/* Industries in detail */}
  <Section paddingTop="small">
    <IndustryDetail />
  </Section>

  {/* Final CTA */}
  <Section theme="dark" paddingTop="large">
    <CtaFinal />
  </Section>
</Layout>
