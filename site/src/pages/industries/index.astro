---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import IndustryDetail from "@/components/content/IndustryDetail.astro";
import CtaFinal from "@/components/content/CtaFinal.astro";
---

<Layout
  title="Industries"
  description="ManyaIT specialists for banking, telecom, healthcare and energy: talent that already knows your sector, its rules and its systems."
>
  {/* Industries in detail */}
  <Section paddingTop="small">
    <IndustryDetail />
  </Section>

  {/* Final CTA */}
  <Section theme="dark" paddingTop="large">
    <CtaFinal />
  </Section>
</Layout>
