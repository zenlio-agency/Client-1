---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HeroDetail from "@/components/content/HeroDetail.astro";
import InsightsGrid from "@/components/content/InsightsGrid.astro";
import FeatureGrid from "@/components/content/FeatureGrid.astro";
import CtaFinal from "@/components/content/CtaFinal.astro";
import { CAPABILITIES, CTA, capabilityHref } from "@/data/site.ts";
import { INSIGHT_PHOTOS } from "@/data/photos.ts";

const capability = (id: string) =>
  capabilityHref(CAPABILITIES.find((cap) => cap.id === id)!);
---

<Layout
  title="Insights"
  description="Perspectives, guides and field notes on data, SAP, AI and engineering from the ManyaIT teams building and running enterprise platforms."
>
  {/* Hero */}
  <Section paddingTop="small">
    <HeroDetail
      crumbs={[{ label: "Home", href: "/" }, { label: "Insights" }]}
      eyebrow="Insights"
      title="Field notes from the teams doing the work."
      lede="Perspectives, guides and explainers on data, SAP, AI and engineering, written by the people who build and run enterprise platforms every day. The first articles are on their way."
      points={["Perspectives", "Guides", "Field notes"]}
      primary={CTA.primary}
      secondary={{ label: "Explore capabilities", href: "/capabilities" }}
      photo={INSIGHT_PHOTOS[0]}
    />
  </Section>

  {/* Articles */}
  <Section theme="tint" id="articles">
    <InsightsGrid />
  </Section>

  {/* Topics */}
  <Section id="topics">
    <FeatureGrid
      eyebrow="Topics"
      heading="What we write about"
      intro="Practical writing for technology leaders and engineers, grounded in the platforms our teams work on."
      items={[
        {
          title: "Applied and agentic AI",
          text: "What it takes to move AI from demo to daily use, and to keep it safe once it's there.",
          href: capability("cap-ai"),
        },
        {
          title: "Data platforms",
          text: "Architecture, governance and the habits that make data trustworthy enough to act on.",
          href: capability("cap-data"),
        },
        {
          title: "SAP and clean core",
          text: "Plain-language guides to S/4HANA, BTP and the decisions that shape an SAP roadmap.",
          href: capability("cap-sap"),
        },
        {
          title: "Digital engineering",
          text: "Modernization, platform engineering and shipping software without drama.",
          href: capability("cap-code"),
        },
        {
          title: "Capability centers",
          text: "Building, running and growing a Global Capability Center, from the first team to a full hub.",
          href: "/about",
        },
        {
          title: "Industry field notes",
          text: "What our teams see in banking, telecom, healthcare and energy programs.",
          href: "/industries",
        },
      ]}
      linkLabel="Explore"
    />
  </Section>

  {/* Final CTA */}
  <Section theme="dark" paddingTop="large">
    <CtaFinal />
  </Section>
</Layout>
