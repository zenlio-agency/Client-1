---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HeroHome from "@/components/content/HeroHome.astro";
import ClientLogos from "@/components/content/ClientLogos.astro";
import WhyMetrics from "@/components/content/WhyMetrics.astro";
import CapabilityBento from "@/components/content/CapabilityBento.astro";
import IndustryCards from "@/components/content/IndustryCards.astro";
import CareersHome from "@/components/content/CareersHome.astro";
import InsightsGrid from "@/components/content/InsightsGrid.astro";
import GlobalPresence from "@/components/content/GlobalPresence.astro";
import EcosystemCards from "@/components/content/EcosystemCards.astro";
import ContactConversation from "@/components/content/ContactConversation.astro";
---

<Layout
  title="Technology & Talent Partners"
  description="ManyaIT is a technology and talent partner that helps global enterprises build and scale capability centers with AI-ready engineering teams."
>
  {/* Hero */}
  <Section paddingTop="none" paddingBottom="small">
    <HeroHome />
  </Section>

  {/* Client logos */}
  <Section paddingTop="small">
    <ClientLogos />
  </Section>

  {/* Why ManyaIT: the figures, on a gradient panel */}
  <Section theme="tint" id="why">
    <WhyMetrics />
  </Section>

  {/* Capabilities */}
  <Section id="capabilities">
    <CapabilityBento />
  </Section>

  {/* Industries */}
  <Section theme="tint" id="industries">
    <IndustryCards />
  </Section>

  {/* Careers */}
  <Section id="careers">
    <CareersHome />
  </Section>

  {/* Insights */}
  <Section theme="tint" id="insights">
    <InsightsGrid />
  </Section>

  {/* Global presence */}
  <Section id="locations">
    <GlobalPresence />
  </Section>

  {/* Other companies */}
  <Section theme="tint" id="ecosystem" paddingTop="small" paddingBottom="small">
    <EcosystemCards />
  </Section>

  {/* Contact form, closing the page above the footer */}
  <Section id="contact">
    <ContactConversation headingTag="h2" />
  </Section>
</Layout>
