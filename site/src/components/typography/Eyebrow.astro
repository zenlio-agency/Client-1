---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. */
  variant?: "default" | "tag";
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div
      class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
      {...rest}
    >
      {variant === "default" && (
        <span class="eyebrow_marker" aria-hidden="true" />
      )}
      <Tag class="eyebrow_text text-style-small">
        <Fragment set:html={content} />
      </Tag>
    </div>
  )
}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: 0.75em;
      color: var(--accent);

      .eyebrow_text {
        font-family: var(--heading-family);
        font-size: 0.78rem;
        font-weight: var(--heading-bold);
        letter-spacing: var(--letter-spacing-wide);
        text-transform: uppercase;
        line-height: 1.2;
      }

      &.tag {
        background-color: var(--accent-soft);
        color: var(--accent-text);
        padding: 0.4em 0.85em;
        border-radius: var(--radius-round);
        .eyebrow_text {
          font-size: 0.75rem;
          letter-spacing: 0.04em;
          text-transform: none;
        }
      }
      .eyebrow_marker {
        flex: none;
        width: 1.5rem;
        height: var(--border-width);
        background-color: currentcolor;
      }
    }
  }
</style>
