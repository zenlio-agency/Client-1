---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import { INDUSTRIES, tbc } from "@/data/site.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /**
   * Show the case study. Keep `false` until an engagement is approved for
   * publication; the capability snapshot shows in its place.
   */
  approved?: boolean;
}

const { render = true, approved = true } = Astro.props;

const results = [
  { value: "[X]%", label: "faster release cycles" },
  { value: "[X]%", label: "less manual effort" },
  { value: "[X] yrs", label: "average team tenure on engagements" },
  { value: "[X]%", label: "of engagements extended after year one" },
];

const steps = [
  {
    label: "Challenge",
    text: "[Enterprise descriptor] needed to [business goal] while [constraint].",
  },
  {
    label: "What we built",
    text: "A dedicated team across Dallas and Hyderabad built [platform or solution] on [technology].",
  },
  {
    label: "How it operated",
    text: "The team runs it today with [service level], [release cadence] and [governance model].",
  },
  {
    label: "Outcome",
    text: "[X]% [primary improvement] · [X] [secondary improvement] · [X] [tertiary improvement]",
  },
];

const snapshot = [
  [
    "Discover",
    "Your leads and ours agree on goals, systems and measures of success.",
  ],
  ["Build", "A dedicated team stands up the platform in short release cycles."],
  [
    "Run",
    "The same team operates it with clear service levels and monthly reporting.",
  ],
  [
    "Scale",
    "Scope and team grow with results, across new functions and use cases.",
  ],
];
---

{
  render && (
    <div class="impact_wrap">
      <div class="impact_head">
        <div class="impact_intro">
          <Eyebrow data-reveal>Enterprise impact</Eyebrow>
          <Heading maxWidth={22} data-reveal style="--reveal-order: 1">
            From complex challenge to measurable impact.
          </Heading>
        </div>
        <div class="impact_aside" data-reveal style="--reveal-order: 2">
          <Paragraph variant="large" maxWidth={44}>
            How a dedicated capability moves from the first workshop to lasting
            results.
          </Paragraph>
        </div>
      </div>

      <div class="impact_results theme-dark" data-reveal>
        <p class="impact_results_lead">
          We measure every capability the same way: by what it changes for the
          business.
        </p>
        <ul class="impact_results_list">
          {results.map((result, index) => (
            <li>
              <span class="impact_results_index">(0{index + 1})</span>
              <span class="impact_results_value" set:html={tbc(result.value)} />
              <span class="impact_results_label">{result.label}</span>
            </li>
          ))}
        </ul>
        <div class="impact_results_row">
          <span>Proven across</span>
          {INDUSTRIES.map((industry) => (
            <a href={`/#${industry.id}`}>{industry.title}</a>
          ))}
        </div>
      </div>

      {approved ? (
        <article class="impact_case" data-reveal>
          <div class="impact_case_meta">
            <span
              set:html={tbc("[Industry] · [Capability] · [Engagement length]")}
            />
            <span class="impact_case_badge">Case study</span>
          </div>
          <ol class="impact_case_steps">
            {steps.map((step, index) => (
              <li
                class:list={[
                  "impact_case_step",
                  index === 3 && "is-outcome theme-brand",
                ]}
              >
                <span class="impact_case_label">{step.label}</span>
                <p set:html={tbc(step.text)} />
              </li>
            ))}
          </ol>
          <figure class="impact_case_quote">
            <blockquote
              set:html={tbc(
                "“[Approved quote from the enterprise sponsor. Two lines at most.]”",
              )}
            />
            <figcaption
              set:html={tbc("[Name], [Title], [Company or descriptor]")}
            />
          </figure>
        </article>
      ) : (
        <article class="impact_case is-snapshot" data-reveal>
          <Heading tag="h3" variant="h4">
            What a ManyaIT engagement looks like.
          </Heading>
          <ol class="impact_case_steps">
            {snapshot.map(([label, text]) => (
              <li class="impact_case_step">
                <span class="impact_case_label">{label}</span>
                <p>{text}</p>
              </li>
            ))}
          </ol>
        </article>
      )}
    </div>
  )
}

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.impact_wrap) :where(.heading, .text) {
      margin-block: 0;
    }
    .impact_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    .impact_head {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5) var(--section-space-small);
      align-items: end;
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      }
    }

    .impact_intro {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .impact_results {
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
      padding: var(--space-7) var(--space-5) var(--space-5);
      border-radius: var(--radius-main);
      overflow: clip;
      @media (width >= 48rem) {
        padding: var(--space-8) var(--space-6) var(--space-6);
      }
      background-image: radial-gradient(
        circle at 90% -20%,
        color-mix(in srgb, var(--blue-500) 35%, transparent),
        transparent 55%
      );
    }

    .impact_results_lead {
      max-width: 30ch;
      font-family: var(--heading-family);
      font-size: var(--h4);
      font-weight: var(--heading-medium);
      line-height: 1.25;
      letter-spacing: var(--letter-spacing-snug);
    }

    .impact_results_list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) 0;
      @media (width >= 64rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
      & li {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding-inline: var(--space-4);
        border-left: var(--border-width) solid var(--border);
        @media (width >= 48rem) {
          padding-inline: var(--space-5);
        }
      }
    }

    .impact_results_index {
      font-size: 0.75rem;
      color: var(--text-2);
    }

    .impact_results_value {
      font-family: var(--heading-family);
      font-size: var(--h3);
      font-weight: var(--heading-bold);
      letter-spacing: var(--letter-spacing-tight);
      line-height: 1;
      white-space: nowrap;
      @media (width >= 48rem) {
        font-size: var(--h2);
      }
    }

    .impact_results_label {
      max-width: 20ch;
      font-size: var(--text-small);
      color: var(--text-body);
    }

    .impact_results_row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-5);
      padding-top: var(--space-5);
      border-top: var(--border-width) solid var(--border);
      font-size: var(--text-small);
      & span {
        margin-right: auto;
        font-family: var(--heading-family);
        font-size: 0.72rem;
        font-weight: var(--heading-bold);
        letter-spacing: var(--letter-spacing-wide);
        text-transform: uppercase;
        color: var(--text-2);
      }
      & a {
        color: var(--text-body);
        transition: color var(--hover-duration) var(--hover-ease);
        @media (hover: hover) {
          &:hover {
            color: var(--text);
          }
        }
      }
    }

    .impact_case {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      padding: var(--space-6);
      background-color: var(--background-2);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
    }

    .impact_case_meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2);
      font-size: var(--text-small);
      color: var(--text-2);
    }

    .impact_case_badge {
      padding: 0.3rem 0.75rem;
      border-radius: var(--radius-round);
      background-color: var(--accent-soft);
      color: var(--accent-text);
      font-family: var(--heading-family);
      font-size: 0.75rem;
      font-weight: var(--heading-medium);
    }

    .impact_case_steps {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      @media (width >= 64rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    .impact_case_step {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-5);
      @media (width >= 48rem) {
        min-height: 11rem;
      }
      border-radius: var(--radius-medium);
      background-color: var(--background-3);
      color: var(--text);
      font-size: var(--text-small);
      line-height: 1.55;
      @media (width >= 64rem) {
        &:not(:last-child)::after {
          content: "→";
          position: absolute;
          top: 50%;
          right: calc(var(--space-3) / -2 - 0.75rem);
          z-index: 1;
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          place-items: center;
          width: 1.5rem;
          height: 1.5rem;
          translate: 0 -50%;
          border-radius: 50%;
          background-color: var(--background-2);
          border: var(--border-width) solid var(--border);
          color: var(--accent);
          font-size: 0.75rem;
        }
      }
      &.is-outcome {
        background-color: var(--background);
      }
    }

    .impact_case_label {
      font-family: var(--heading-family);
      font-size: 0.72rem;
      font-weight: var(--heading-bold);
      letter-spacing: var(--letter-spacing-wide);
      text-transform: uppercase;
      color: var(--accent);
      .is-outcome & {
        color: var(--blue-100);
      }
    }

    .impact_case_quote {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding-top: var(--space-5);
      border-top: var(--border-width) solid var(--divider);
      & blockquote {
        font-family: var(--heading-family);
        font-size: var(--h5);
        font-weight: var(--heading-medium);
        line-height: 1.4;
        color: var(--text);
      }
      & figcaption {
        font-size: var(--text-small);
        color: var(--text-2);
      }
    }
  }
</style>
