---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import { tbc } from "@/data/site.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Pill label above the heading. */
  eyebrow?: string;
  /** Section heading. */
  heading?: string;
  /** Paragraph beside the heading. */
  intro?: string;
  /** Steps in order. `note` is a short result shown under each one. */
  steps?: { title: string; text: string; note?: string }[];
}

const { render = true, eyebrow, heading, intro, steps = [] } = Astro.props;
---

{
  render && heading && steps.length > 0 && (
    <div class="process-steps_wrap">
      <div class="process-steps_head">
        <div class="process-steps_intro">
          {eyebrow && <Eyebrow data-reveal>{eyebrow}</Eyebrow>}
          <Heading maxWidth={20} data-reveal style="--reveal-order: 1">
            {heading}
          </Heading>
        </div>
        {intro && (
          <Paragraph
            variant="large"
            maxWidth={44}
            data-reveal
            style="--reveal-order: 2"
          >
            {intro}
          </Paragraph>
        )}
      </div>
      <ol class="process-steps_list" style={`--_count: ${steps.length}`}>
        {steps.map((step, index) => (
          <li
            class="process-steps_item"
            data-reveal
            style={`--reveal-order: ${index}`}
          >
            <span class="process-steps_number">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="process-steps_title">{step.title}</h3>
            <p class="process-steps_text" set:html={tbc(step.text)} />
            {step.note && (
              <span class="process-steps_note" set:html={tbc(step.note)} />
            )}
          </li>
        ))}
      </ol>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.process-steps_wrap) :where(.heading, .text) {
      margin-block: 0;
    }

    .process-steps_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    .process-steps_head {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5) var(--section-space-small);
      align-items: end;
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      }
    }

    .process-steps_intro {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }

    /* A line runs along the top of the steps, with each number sitting
       on it. */
    .process-steps_list {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: calc(var(--space-6) + 1.375rem) var(--site-gutter);
      padding-top: 1.375rem;
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      @media (width >= 64rem) {
        grid-template-columns: repeat(var(--_count), minmax(0, 1fr));
      }
    }

    .process-steps_item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      padding-top: var(--space-5);
      border-top: var(--border-width) solid var(--border);
    }

    .process-steps_number {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      margin-top: calc(var(--space-5) * -1 - 1.375rem);
      margin-bottom: var(--space-2);
      border-radius: 50%;
      background-color: var(--blue-500);
      font-family: var(--display-family);
      font-size: var(--text-small);
      font-weight: 700;
      color: var(--white);
      box-shadow: 0 0 0 0.375rem var(--background);
    }

    .process-steps_title {
      font-family: var(--display-family);
      font-size: var(--h5);
      font-weight: var(--heading-bold);
      line-height: 1.25;
      letter-spacing: var(--letter-spacing-snug);
      color: var(--text);
    }

    .process-steps_text {
      font-size: var(--text-small);
      line-height: 1.6;
      color: var(--text-body);
    }

    .process-steps_note {
      margin-top: auto;
      padding: 0.35rem 0.8rem;
      border-radius: var(--radius-round);
      background-color: var(--accent-soft);
      font-family: var(--heading-family);
      font-size: 0.78rem;
      font-weight: var(--heading-medium);
      color: var(--accent-text);
    }
  }
</style>
