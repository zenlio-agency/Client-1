---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const steps = [
  {
    title: "Discover",
    line: "Map goals, systems and outcomes.",
    text: "Workshops with your business and technology leads, a current-state review and agreed measures of success.",
    output: "Capability blueprint",
  },
  {
    title: "Build",
    line: "Stand up the platform, solution or capability.",
    text: "A dedicated team onboards to your tools and controls, then ships in short release cycles.",
    output: "A working platform in production",
  },
  {
    title: "Run",
    line: "Operate with security, governance and clear service levels.",
    text: "Monitoring, support and continuous improvement across both hubs, reported against the measures you set.",
    output: "Service levels you can track",
  },
  {
    title: "Scale",
    line: "Expand what works across functions, regions and use cases.",
    text: "Grow the team and its scope as results come in, without restarting the learning curve.",
    output: "A capability that grows with you",
  },
];
---

{
  render && (
    <div class="process_wrap">
      <div class="process_head">
        <Eyebrow data-reveal>How we work</Eyebrow>
        <Heading variant="display" data-reveal style="--reveal-order: 1">
          Build. Run. Scale.
        </Heading>
        <Paragraph
          variant="large"
          maxWidth={48}
          data-reveal
          style="--reveal-order: 2"
        >
          Every capability follows the same path, whether it starts with one
          platform or a full engineering hub.
        </Paragraph>
      </div>

      <div class="process_rail" aria-hidden="true">
        <span class="process_rail_fill" />
      </div>

      <ol class="process_steps">
        {steps.map((step, index) => (
          <li
            class="process_step"
            data-reveal
            style={`--reveal-order: ${index}`}
          >
            <span class="process_number">0{index + 1}</span>
            <Heading tag="h3" variant="h4" class="process_title">
              {step.title}
            </Heading>
            <p class="process_line">{step.line}</p>
            <Paragraph variant="small">{step.text}</Paragraph>
            <div class="process_output">
              <span>Output</span>
              {step.output}
            </div>
          </li>
        ))}
      </ol>

      <div class="process_loop text-style-small" data-reveal>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 12a8 8 0 1 1-2.34-5.66M20 4v4h-4" />
        </svg>
        What we learn in Run feeds the next Discover, every quarter.
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.process_wrap) :where(.heading, .text) {
      margin-block: 0;
    }
    .process_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    .process_head {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    /* A rail across the four steps that fills as the section scrolls past.
       Browsers without scroll-driven animation show it full. */
    .process_rail {
      position: relative;
      height: 0.25rem;
      margin-top: var(--space-4);
      border-radius: var(--radius-round);
      background-color: color-mix(in srgb, var(--accent) 14%, transparent);
      overflow: clip;
      @media (width < 64rem) {
        display: none;
      }
    }

    .process_rail_fill {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background-color: var(--accent);
      transform-origin: left;
    }

    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .process_rail_fill {
          animation: process-fill linear both;
          animation-timeline: view();
          animation-range: entry 40% cover 55%;
        }
      }
    }

    @keyframes process-fill {
      from {
        scale: 0 1;
      }
      to {
        scale: 1 1;
      }
    }

    .process_steps {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-7) var(--site-gutter);
      counter-reset: step;
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      @media (width >= 64rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin-top: calc(var(--space-7) * -1);
      }
    }

    .process_step {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      @media (width < 64rem) {
        padding-left: var(--space-5);
        border-left: 0.125rem solid var(--accent);
      }
    }

    .process_number {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      margin-bottom: var(--space-2);
      border-radius: 50%;
      background-color: var(--background-2);
      border: 0.125rem solid var(--accent);
      font-family: var(--heading-family);
      font-size: 0.8rem;
      font-weight: var(--heading-bold);
      color: var(--accent);
      @media (width >= 64rem) {
        margin-top: calc(var(--space-7) * -0.5 - 1.25rem);
      }
    }

    .process_line {
      font-family: var(--heading-family);
      font-weight: var(--heading-medium);
      color: var(--text);
      line-height: 1.4;
    }

    .process_output {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      margin-top: auto;
      padding-top: var(--space-3);
      border-top: var(--border-width) solid var(--border);
      font-size: var(--text-small);
      color: var(--text);
      & span {
        font-family: var(--heading-family);
        font-size: 0.7rem;
        font-weight: var(--heading-bold);
        letter-spacing: var(--letter-spacing-wide);
        text-transform: uppercase;
        color: var(--accent);
      }
    }

    .process_loop {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      align-self: flex-start;
      padding: 0.55rem 1rem;
      border-radius: var(--radius-round);
      background-color: var(--background-2);
      border: var(--border-width) solid var(--border);
      color: var(--text-body);
      & svg {
        width: 1.1rem;
        fill: none;
        stroke: var(--accent);
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
    }
  }
</style>
