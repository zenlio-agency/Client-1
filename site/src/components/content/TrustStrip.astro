---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import { tbc } from "@/data/site.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const stats = [
  { value: "[XX]+", label: "Years powering enterprise technology" },
  { value: "[XX]+", label: "Global enterprises served" },
  { value: "[XX]+", label: "Specialists in our talent network" },
  { value: "[X] wks", label: "Average time to a productive team" },
];
---

{
  render && (
    <div class="trust-strip_wrap theme-dark" data-reveal>
      <Eyebrow>ManyaIT at a glance</Eyebrow>
      <ul class="trust-strip_list">
        {stats.map((stat, index) => (
          <li
            class="trust-strip_item"
            data-reveal
            style={`--reveal-order: ${index + 1}`}
          >
            <span class="trust-strip_value" set:html={tbc(stat.value)} />
            <span class="trust-strip_label">{stat.label}</span>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Padding trimmed and type scaled up so the figures, not the empty
       space, fill the card (content was under half its height). */
    .trust-strip_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      padding: var(--space-5);
      border-radius: 1.75rem;
      overflow: clip;
      background-image: radial-gradient(
        circle at 100% 0%,
        color-mix(in srgb, var(--blue-500) 38%, transparent),
        transparent 55%
      );
      @media (width >= 64rem) {
        padding: var(--space-6) var(--space-6) var(--space-7);
      }
    }

    .trust-strip_list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) 0;
      @media (width >= 64rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    .trust-strip_item {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding-inline: var(--space-4) var(--space-2);
      border-left: var(--border-width) solid var(--border);
      @media (width >= 48rem) {
        padding-inline: var(--space-5);
      }
    }

    /* Figures scale with the viewport up to 4rem (64px). */
    .trust-strip_value {
      font-family: var(--display-family);
      font-size: clamp(2rem, 1.1rem + 2.8vw, 4rem);
      font-weight: 700;
      letter-spacing: var(--letter-spacing-tight);
      line-height: 1;
      color: var(--text);
      white-space: nowrap;
    }

    .trust-strip_label {
      max-width: 22ch;
      font-size: var(--text-main);
      line-height: 1.45;
      color: var(--text-body);
    }
  }
</style>
