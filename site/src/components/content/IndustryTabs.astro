---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/ui-arrow.svg";
import { INDUSTRIES, CTA, tbc } from "@/data/site.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <div class="industries_wrap" data-industries>
      <div class="industries_head">
        <div class="industries_intro">
          <Eyebrow data-reveal>Industries</Eyebrow>
          <Heading maxWidth={22} data-reveal style="--reveal-order: 1">
            Deep industry knowledge. Built for the way you operate.
          </Heading>
        </div>
        <Paragraph
          variant="large"
          maxWidth={44}
          data-reveal
          style="--reveal-order: 2"
        >
          Our teams learn your industry, your rules and your customers, then
          keep delivering long after the first release.
        </Paragraph>
      </div>

      <div class="industries_body" data-reveal style="--reveal-order: 1">
        <div
          class="industries_tabs"
          role="tablist"
          aria-label="Industries"
          aria-orientation="vertical"
        >
          {INDUSTRIES.map((industry, index) => (
            <button
              class="industries_tab"
              type="button"
              role="tab"
              id={`tab-${industry.id}`}
              aria-controls={`panel-${industry.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? undefined : "-1"}
              data-target={industry.id}
            >
              <span class="industries_tab_index">0{index + 1}</span>
              <span class="industries_tab_text">
                <span class="industries_tab_title">{industry.title}</span>
                <span class="industries_tab_line">{industry.hero}</span>
              </span>
              <Icon src={arrow} variant="small" class="industries_tab_arrow" />
            </button>
          ))}
        </div>

        <div class="industries_panels">
          {INDUSTRIES.map((industry, index) => (
            <section
              class="industries_panel"
              role="tabpanel"
              id={`panel-${industry.id}`}
              aria-labelledby={`tab-${industry.id}`}
              hidden={index !== 0}
            >
              <span class="industries_anchor" id={industry.id} />
              <Eyebrow variant="tag">{industry.title}</Eyebrow>
              <Heading tag="h3" variant="h3" maxWidth={24}>
                {industry.hero}
              </Heading>
              <dl class="industries_facts">
                <div>
                  <dt>The challenge</dt>
                  <dd>{industry.challenge}</dd>
                </div>
                <div>
                  <dt>What we build</dt>
                  <dd>{industry.build}</dd>
                </div>
              </dl>
              <div class="industries_outcome">
                <span
                  class="industries_metric"
                  set:html={tbc(industry.metric)}
                />
                <span>
                  <strong>{industry.outcome}</strong>
                  <span>{industry.metricLabel}</span>
                </span>
              </div>
              <Button
                element="link"
                href={`${CTA.primary.href}?topic=${industry.id}`}
                emphasis="tertiary"
                class="industries_link"
              >
                Talk to us about {industry.title}
                <Icon src={arrow} variant="small" class="button_icon" />
              </Button>
            </section>
          ))}
        </div>
      </div>
    </div>
  )
}

<script>
  for (const block of document.querySelectorAll<HTMLElement>(
    "[data-industries]",
  )) {
    const tabs = [...block.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [
      ...block.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
    ];

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", String(on));
        if (on) tab.removeAttribute("tabindex");
        else tab.setAttribute("tabindex", "-1");
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
        if (i === index) {
          panel.classList.remove("is-entering");
          void panel.offsetWidth;
          panel.classList.add("is-entering");
        }
      });
      if (focus) tabs[index]?.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", (event) => {
        const keys: Record<string, number> = {
          ArrowDown: 1,
          ArrowRight: 1,
          ArrowUp: -1,
          ArrowLeft: -1,
        };
        if (event.key in keys) {
          event.preventDefault();
          select((index + keys[event.key] + tabs.length) % tabs.length, true);
        } else if (event.key === "Home") {
          event.preventDefault();
          select(0, true);
        } else if (event.key === "End") {
          event.preventDefault();
          select(tabs.length - 1, true);
        }
      });
    });

    /* Links like /#industry-energy open the matching tab and bring the
       section into view. */
    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const index = tabs.findIndex((tab) => tab.dataset.target === id);
      if (index < 0) return;
      select(index);
      block.scrollIntoView({ block: "start" });
    };
    fromHash();
    window.addEventListener("hashchange", fromHash);
  }
</script>

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.industries_wrap) :where(.heading, .text) {
      margin-block: 0;
    }
    .industries_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      scroll-margin-top: calc(var(--nav-height) + var(--space-5));
    }

    .industries_head {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5) var(--section-space-small);
      align-items: end;
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      }
    }

    .industries_intro {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .industries_body {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--site-gutter);
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      }
    }

    .industries_tabs {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .industries_tab {
      position: relative;
      display: flex;
      align-items: center;
      gap: var(--space-4);
      width: 100%;
      padding: var(--space-4) var(--space-5);
      border: var(--border-width) solid transparent;
      border-radius: var(--radius-main);
      color: var(--text);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      &::before {
        content: "";
        position: absolute;
        left: 0;
        top: 20%;
        bottom: 20%;
        width: 0.2rem;
        border-radius: var(--radius-round);
        background-color: var(--accent);
        scale: 1 0;
        transition: scale 400ms var(--reveal-ease);
      }
      &[aria-selected="true"] {
        background-color: var(--background-2);
        border-color: var(--border);
        box-shadow: var(--shadow-raised);
        &::before {
          scale: 1 1;
        }
        .industries_tab_index {
          color: var(--accent);
        }
        .industries_tab_arrow {
          opacity: 1;
          translate: 0 0;
          color: var(--accent);
        }
      }
      @media (hover: hover) {
        &:hover:not([aria-selected="true"]) {
          background-color: color-mix(
            in srgb,
            var(--background-2) 60%,
            transparent
          );
        }
      }
    }

    .industries_tab_index {
      font-family: var(--heading-family);
      font-size: 0.75rem;
      font-weight: var(--heading-bold);
      color: var(--text-2);
      transition: color var(--hover-duration) var(--hover-ease);
    }

    .industries_tab_text {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .industries_tab_title {
      font-family: var(--heading-family);
      font-size: var(--h6);
      font-weight: var(--heading-bold);
    }

    .industries_tab_line {
      font-size: var(--text-small);
      color: var(--text-2);
    }

    .industries_tab_arrow {
      opacity: 0;
      translate: -0.5rem 0;
      transition:
        opacity var(--hover-duration) var(--hover-ease),
        translate 400ms var(--reveal-ease);
    }

    .industries_panels {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .industries_panel {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
      padding: var(--space-7) var(--space-6);
      background-color: var(--background-2);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      &[hidden] {
        display: none;
      }
      &.is-entering > * {
        animation: industries-in 600ms var(--reveal-ease) both;
      }
      &.is-entering > :nth-child(3) {
        animation-delay: 40ms;
      }
      &.is-entering > :nth-child(4) {
        animation-delay: 80ms;
      }
      &.is-entering > :nth-child(n + 5) {
        animation-delay: 120ms;
      }
    }

    @keyframes industries-in {
      from {
        opacity: 0;
        translate: 0 0.75rem;
      }
    }

    .industries_anchor {
      position: absolute;
      top: calc(var(--nav-height) * -1 - var(--space-8));
    }

    .industries_facts {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
      width: 100%;
      padding-top: var(--space-5);
      border-top: var(--border-width) solid var(--divider);
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      & div {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
      }
      & dt {
        font-family: var(--heading-family);
        font-size: 0.72rem;
        font-weight: var(--heading-bold);
        letter-spacing: var(--letter-spacing-wide);
        text-transform: uppercase;
        color: var(--text-2);
      }
      & dd {
        margin: 0;
        font-size: var(--text-small);
        color: var(--text-body);
      }
    }

    .industries_outcome {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      width: 100%;
      padding: var(--space-4) var(--space-5);
      border-radius: var(--radius-medium);
      background-color: var(--background-3);
      & > span:last-child {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        font-size: var(--text-small);
        color: var(--text-2);
      }
      & strong {
        color: var(--text);
        font-weight: var(--primary-bold);
      }
    }

    .industries_metric {
      font-family: var(--heading-family);
      font-size: var(--h3);
      font-weight: var(--heading-bold);
      letter-spacing: var(--letter-spacing-tight);
      line-height: 1;
      color: var(--accent);
    }

    .industries_link {
      margin-top: auto;
    }
  }
</style>
