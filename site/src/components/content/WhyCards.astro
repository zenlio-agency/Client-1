---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const cards = [
  {
    title: "Talent that fits",
    figure: "Right skills. Right fit.",
    text: "Specialists matched to your stack, your domain and the way your teams work.",
  },
  {
    title: "Ready in weeks",
    figure: "Weeks, not quarters",
    text: "Go from a skills brief to a productive team without the long ramp-up.",
  },
  {
    title: "Your center, your way",
    figure: "Build · Operate · Transfer",
    text: "We set up and run your GCC with you, then hand it over when you're ready.",
  },
  {
    title: "Scale on demand",
    figure: "Grow with your roadmap",
    text: "Add new skills or expand teams as priorities shift, without starting over.",
  },
];
---

{
  render && (
    <div class="why-cards_wrap">
      <div class="why-cards_head">
        <div class="why-cards_intro">
          <Eyebrow data-reveal>Why ManyaIT</Eyebrow>
          <Heading maxWidth={20} data-reveal style="--reveal-order: 1">
            The right people. Ready faster. Built to stay.
          </Heading>
        </div>
        <Paragraph
          variant="large"
          maxWidth={44}
          data-reveal
          style="--reveal-order: 2"
        >
          We bring the specialists, the setup and the support your Global
          Capability Center (GCC) needs to grow without slowing down.
        </Paragraph>
      </div>
      <ol class="why-cards_list">
        {cards.map((card, index) => (
          <li
            class="why-cards_card"
            data-reveal
            style={`--reveal-order: ${index}`}
          >
            <span class="why-cards_index">0{index + 1}</span>
            <Heading tag="h3" variant="h5" class="why-cards_title">
              {card.title}
            </Heading>
            <p class="why-cards_figure">{card.figure}</p>
            <Paragraph variant="small" class="why-cards_text">
              {card.text}
            </Paragraph>
          </li>
        ))}
      </ol>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.why-cards_wrap) :where(.heading, .text) {
      margin-block: 0;
    }

    .why-cards_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    .why-cards_head {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5) var(--section-space-small);
      align-items: end;
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      }
    }

    .why-cards_intro {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .why-cards_list {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--site-gutter);
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      @media (width >= 64rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    .why-cards_card {
      display: flex;
      flex-direction: column;
      padding: var(--space-5);
      background-color: var(--background-2);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      transition:
        border-color var(--hover-duration) var(--hover-ease),
        box-shadow 400ms var(--reveal-ease),
        translate 400ms var(--reveal-ease);
      @media (width >= 48rem) {
        min-height: 19rem;
      }
      @media (hover: hover) {
        &:hover {
          border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
          box-shadow: var(--shadow-float);
          translate: 0 -0.25rem;
          .why-cards_index {
            background-color: var(--accent);
            color: var(--white);
          }
        }
      }
    }

    .why-cards_index {
      align-self: flex-start;
      padding: 0.3rem 0.6rem;
      border-radius: var(--radius-round);
      background-color: var(--background-3);
      font-family: var(--heading-family);
      font-size: 0.72rem;
      font-weight: var(--heading-bold);
      color: var(--text-2);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
    }

    .why-cards_title {
      margin-top: var(--space-4);
    }

    .why-cards_figure {
      margin-block: auto var(--space-4);
      padding-top: var(--space-6);
      font-family: var(--display-family);
      font-size: var(--h5);
      font-weight: 700;
      letter-spacing: var(--letter-spacing-snug);
      line-height: 1.2;
      color: var(--accent);
      --_trim-top: var(--display-family-trim-top);
      --_trim-bottom: var(--display-family-trim-bottom);
    }

    .why-cards_text {
      padding-top: var(--space-4);
      border-top: var(--border-width) solid var(--divider);
    }
  }
</style>
