---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

/* Split into words so each one can light up as the reader scrolls. */
const statement =
  "We bring the specialists, the setup and the support your Global Capability Center needs to grow without slowing down. Vetted, AI-ready engineers matched to your stack. Teams live in weeks, not quarters. And a clear path to build, operate and transfer, so the capability you scale is always yours.";
const words = statement.split(" ");
---

{
  render && (
    <div class="why-cards_wrap">
      <div class="why-cards_intro">
        <Eyebrow data-reveal>Why ManyaIT</Eyebrow>
        <Heading
          class="heading-accent"
          maxWidth={22}
          data-reveal
          style="--reveal-order: 1"
        >
          The right people. Ready faster. <strong>Built to stay.</strong>
        </Heading>
      </div>
      <p class="why-cards_statement" data-scroll-words>
        {words.map((word) => (
          <Fragment>
            <span class="why-cards_word">{word}</span>{" "}
          </Fragment>
        ))}
      </p>
    </div>
  )
}

<script>
  /* Scroll-synced fade: words darken one after another as the statement
     moves up the screen, with a soft trail of half-lit words at the edge.
     Still for reduced motion; without JS every word shows at full strength. */
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");

  for (const block of document.querySelectorAll<HTMLElement>(
    "[data-scroll-words]",
  )) {
    if (reduced.matches) break;
    const words = [...block.querySelectorAll<HTMLElement>(".why-cards_word")];
    const trail = 6;
    let queued = false;

    const update = () => {
      queued = false;
      const box = block.getBoundingClientRect();
      const start = window.innerHeight * 0.85;
      const end = window.innerHeight * 0.35;
      /* 0 when the top reaches 85% of the screen, 1 when the bottom
         reaches 35%. */
      const progress = Math.min(
        Math.max((start - box.top) / (start - end + box.height), 0),
        1,
      );
      const lit = progress * (words.length + trail);
      words.forEach((word, index) => {
        const amount = Math.min(Math.max((lit - index) / trail, 0), 1);
        word.style.opacity = String(0.16 + amount * 0.84);
      });
    };

    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
  }
</script>

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.why-cards_wrap) :where(.heading, .text) {
      margin-block: 0;
    }

    /* Centered composition with a clear hierarchy: the heading is the
       headline (display size, bold, ink, blue accent); the statement sits at
       body scale, about half its size, in the softer body color. */
    .why-cards_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-7);
      text-align: center;
      --_alignment: center;
    }

    /* The label and heading sit on the left like the other sections. */
    .why-cards_intro {
      align-self: stretch;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
      text-align: left;
      --_alignment: start;
    }

    .why-cards_statement {
      max-width: 54ch;
      font-family: var(--primary-family);
      font-size: clamp(1.125rem, 0.9rem + 0.9vw, 1.5rem);
      font-weight: var(--primary-regular);
      line-height: 1.65;
      text-wrap: pretty;
      color: var(--text-body);
    }

    .why-cards_word {
      transition: opacity 150ms linear;
    }
  }
</style>
