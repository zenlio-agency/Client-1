---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/ui-arrow.svg";
import { CAREERS_PHOTO } from "@/data/photos.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

/* Line icons drawn on a 24px grid, stroked in the accent color. */
const icons = {
  layers:
    '<path d="M12 3 3 7.5l9 4.5 9-4.5L12 3Z"/><path d="m3 12 9 4.5 9-4.5"/><path d="m3 16.5 9 4.5 9-4.5"/>',
  shield:
    '<path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
  growth: '<path d="m3 17 6-6 4 4 8-8"/><path d="M14 7h7v7"/>',
};

const points = [
  {
    icon: icons.layers,
    title: "Real enterprise work",
    text: "Banking, telecom, healthcare and energy platforms that millions of people rely on.",
  },
  {
    icon: icons.shield,
    title: "Long-term ownership",
    text: "Join a dedicated team, learn one business deeply and own its systems.",
  },
  {
    icon: icons.growth,
    title: "Learning & growth",
    text: "Mentors, paid certifications on SAP, cloud and AI, and leads promoted from within.",
  },
];
---

{
  render && (
    <div class="careers-home_panel theme-dark" data-reveal>
      <div class="careers-home_copy">
        <Eyebrow>Careers</Eyebrow>
        <Heading variant="h1" maxWidth={16}>
          Build systems <span class="careers-home_accent">that matter.</span>
        </Heading>
        <ul class="careers-home_points">
          {points.map((point) => (
            <li>
              <div class="careers-home_point_head">
                <svg
                  class="careers-home_icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  set:html={point.icon}
                />
                <h3 class="careers-home_point_title">{point.title}</h3>
              </div>
              <p class="careers-home_point_text">{point.text}</p>
            </li>
          ))}
        </ul>
        <Button element="link" href="/careers" class="careers-home_button">
          Explore Careers
          <Icon src={arrow} variant="small" class="button_icon" />
        </Button>
      </div>
      <div class="careers-home_media">
        <img src={CAREERS_PHOTO} alt="" loading="lazy" decoding="async" />
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.careers-home_panel) :where(.heading, .text) {
      margin-block: 0;
    }

    /* Dark rounded panel: copy and a list on the left, a photo on the right. */
    .careers-home_panel {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-7) var(--section-space-small);
      padding: var(--space-6);
      border-radius: 2rem;
      background-color: var(--background);
      color: var(--text);
      @media (width >= 48rem) {
        padding: var(--space-8);
      }
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        padding: var(--section-space-small);
      }
    }

    .careers-home_copy {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
    }

    /* Manya Blue, one step lighter (#5A70EC) so it reads on black. Shared by
       the accent words and the list icons; the pill dot uses it too. */
    .careers-home_panel {
      --_brand: var(--blue-400);
    }

    .careers-home_accent {
      color: var(--_brand);
    }

    .careers-home_points {
      width: 100%;
      display: flex;
      flex-direction: column;
      margin-top: var(--space-3);
      & > li {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding-block: var(--space-5);
        border-top: var(--border-width) solid var(--divider);
      }
      & > li:first-child {
        padding-top: 0;
        border-top: 0;
      }
    }

    .careers-home_point_head {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .careers-home_icon {
      flex: none;
      width: 2rem;
      height: 2rem;
      fill: none;
      stroke: var(--_brand);
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .careers-home_point_title {
      font-family: var(--heading-family);
      font-size: var(--h5);
      font-weight: var(--heading-medium);
      color: var(--text);
    }

    .careers-home_point_text {
      max-width: 44ch;
      color: var(--text-2);
    }

    .careers-home_button {
      margin-top: var(--space-2);
    }

    .careers-home_media {
      min-height: 22rem;
      overflow: hidden;
      border-radius: 1.25rem;
      background-color: rgb(255 255 255 / 0.04);
      & img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
  }
</style>
