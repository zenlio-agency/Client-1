---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/ui-arrow.svg";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <div class="careers-home_wrap" data-reveal>
      <div class="careers-home_copy">
        <Eyebrow>Careers</Eyebrow>
        <Heading maxWidth={18}>Build systems that matter.</Heading>
        <Paragraph variant="large" maxWidth={46}>
          Work on enterprise platforms millions of people rely on, with mentors,
          certifications and a clear path to grow.
        </Paragraph>
      </div>
      <Button element="link" href="/careers" class="careers-home_button">
        Explore Careers
        <Icon src={arrow} variant="small" class="button_icon" />
      </Button>
      <svg class="careers-home_mark" viewBox="0 0 190 120" aria-hidden="true">
        <path d="M0 0 161 119.5H135L24 37.6v58.9L0 119.5Z" />
        <path d="M189.5 0v119.5H167V36l-57.6 34.7-13.7-9.7Z" />
      </svg>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.careers-home_wrap) :where(.heading, .text) {
      margin-block: 0;
    }

    .careers-home_wrap {
      position: relative;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
      padding: var(--space-7) var(--space-6);
      border: var(--border-width) solid var(--border);
      border-radius: 1.75rem;
      background-color: var(--background-2);
      background-image: radial-gradient(
        circle at 100% 100%,
        var(--blue-50),
        transparent 55%
      );
      overflow: clip;
      @media (width >= 64rem) {
        flex-direction: row;
        align-items: flex-end;
        justify-content: space-between;
        padding: var(--space-8) var(--space-7);
      }
    }

    .careers-home_copy {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .careers-home_button {
      position: relative;
      flex: none;
    }

    .careers-home_mark {
      position: absolute;
      top: var(--space-6);
      right: var(--space-6);
      width: 6rem;
      fill: var(--accent-soft);
      @media (width < 48rem) {
        display: none;
      }
    }
  }
</style>
