---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import { tbc } from "@/data/site.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const filters = [
  "All",
  "AI",
  "Data",
  "SAP",
  "Digital Engineering",
  "Enterprise Technology",
];

const articles = [
  {
    category: "AI",
    type: "Perspective",
    title:
      "Why most AI pilots stall, and what the ones in production did differently",
    summary:
      "The gap between demo and daily use is rarely the model. It is data, ownership and how the work is run.",
    featured: true,
  },
  {
    category: "Data",
    type: "Guide",
    title: "AI-ready data starts long before the model",
    summary:
      "What a data product needs in place before it can feed an AI use case.",
  },
  {
    category: "SAP",
    type: "Explainer",
    title: "Clean core, explained for the people who fund it",
    summary:
      "What an upgrade-ready SAP S/4HANA core means for cost, risk and speed.",
  },
  {
    category: "Enterprise Technology",
    type: "Field notes",
    title: "Two cities, one team: how a platform runs around the clock",
    summary:
      "Handoffs, overlap hours and the habits that keep a two-city team working as one.",
  },
  {
    category: "Digital Engineering",
    type: "Field notes",
    title: "Modernizing a legacy application without freezing the roadmap",
    summary: "How to keep shipping while the platform underneath is rebuilt.",
  },
];

const slug = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

{
  render && (
    <div class="insights_wrap" data-insights>
      <div class="insights_head">
        <div class="insights_intro">
          <Eyebrow data-reveal>Insights</Eyebrow>
          <Heading maxWidth={20} data-reveal style="--reveal-order: 1">
            Ideas shaping technology, data and AI.
          </Heading>
          <Paragraph
            variant="large"
            maxWidth={46}
            data-reveal
            style="--reveal-order: 2"
          >
            Field notes from the teams building and running enterprise
            platforms.
          </Paragraph>
        </div>
        <div
          class="insights_filters"
          role="group"
          aria-label="Filter insights"
          data-reveal
          style="--reveal-order: 3"
        >
          {filters.map((filter, index) => (
            <button
              class="insights_filter"
              type="button"
              aria-pressed={index === 0 ? "true" : "false"}
              data-filter={filter === "All" ? "all" : slug(filter)}
            >
              {filter}
            </button>
          ))}
        </div>
      </div>

      <div class="insights_grid">
        {articles.map((article, index) => (
          <article
            class:list={["insights_card", article.featured && "is-featured"]}
            data-category={slug(article.category)}
            data-reveal
            style={`--reveal-order: ${index % 3}`}
          >
            <div
              class:list={["insights_cover", `is-${slug(article.category)}`]}
              aria-hidden="true"
            >
              {article.featured && <span class="insights_cover_word">AI</span>}
            </div>
            <div class="insights_body">
              <div class="insights_meta">
                <span class="insights_category">{article.category}</span>
                <span>{article.type}</span>
                <span set:html={tbc("[X] min read")} />
              </div>
              <Heading
                tag="h3"
                variant={article.featured ? "h4" : "h6"}
                class="insights_title"
              >
                {article.title}
              </Heading>
              <Paragraph variant="small" class="insights_summary">
                {article.summary}
              </Paragraph>
              <span class="insights_soon">Coming soon</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  )
}

<script>
  for (const block of document.querySelectorAll<HTMLElement>(
    "[data-insights]",
  )) {
    const buttons = [
      ...block.querySelectorAll<HTMLButtonElement>("[data-filter]"),
    ];
    const cards = [...block.querySelectorAll<HTMLElement>("[data-category]")];
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter;
        buttons.forEach((b) =>
          b.setAttribute("aria-pressed", String(b === button)),
        );
        for (const card of cards) {
          const show = filter === "all" || card.dataset.category === filter;
          card.classList.toggle("is-filtered", !show);
          card.hidden = !show;
        }
        block.classList.toggle("is-filtering", filter !== "all");
      });
    }
  }
</script>

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.insights_wrap) :where(.heading, .text) {
      margin-block: 0;
    }
    .insights_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    .insights_head {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6) var(--section-space-small);
      align-items: end;
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      }
    }

    .insights_intro {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .insights_filters {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      @media (width >= 64rem) {
        justify-content: flex-end;
      }
    }

    .insights_filter {
      padding: 0.5rem 1rem;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-round);
      background-color: var(--background-2);
      font-family: var(--heading-family);
      font-size: 0.8rem;
      font-weight: var(--heading-medium);
      color: var(--text-body);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          border-color: var(--text);
          color: var(--text);
        }
      }
      &[aria-pressed="true"] {
        background-color: var(--text);
        border-color: var(--text);
        color: var(--background);
      }
    }

    .insights_grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--site-gutter);
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      @media (width >= 64rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        .insights_wrap:not(.is-filtering) & .is-featured {
          grid-column: span 2;
          grid-row: span 2;
        }
      }
    }

    .insights_card {
      display: flex;
      flex-direction: column;
      background-color: var(--background-2);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      overflow: clip;
      transition:
        border-color var(--hover-duration) var(--hover-ease),
        box-shadow 400ms var(--reveal-ease),
        translate 400ms var(--reveal-ease);
      &[hidden] {
        display: none;
      }
      @media (hover: hover) {
        &:hover {
          border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
          box-shadow: var(--shadow-float);
          translate: 0 -0.25rem;
        }
      }
    }

    .insights_cover {
      position: relative;
      height: 6rem;
      overflow: clip;
      background-color: var(--blue-50);
      .is-featured > & {
        height: auto;
        min-height: 14rem;
        flex: 1;
      }
      &.is-ai {
        background-color: var(--blue-500);
        background-image:
          radial-gradient(
            circle at 85% 30%,
            transparent 0 18%,
            rgb(255 255 255 / 0.12) 18% 18.5%,
            transparent 18.5% 30%,
            rgb(255 255 255 / 0.1) 30% 30.5%,
            transparent 30.5% 44%,
            rgb(255 255 255 / 0.08) 44% 44.5%,
            transparent 44.5%
          ),
          linear-gradient(135deg, var(--blue-500), var(--blue-800));
      }
      &.is-data {
        background-image: radial-gradient(
          var(--blue-300) 0.09rem,
          transparent 0.1rem
        );
        background-size: 0.9rem 0.9rem;
      }
      &.is-sap {
        background-color: var(--section-tint);
        background-image: repeating-linear-gradient(
          to bottom,
          transparent 0 0.9rem,
          var(--blue-200) 0.9rem 1rem
        );
      }
      &.is-enterprise-technology {
        background-color: var(--ink-black);
        background-image: repeating-linear-gradient(
          135deg,
          transparent 0 0.8rem,
          rgb(145 160 242 / 0.35) 0.8rem 0.85rem
        );
      }
      &.is-digital-engineering {
        background-image:
          linear-gradient(var(--blue-100) 0.0625rem, transparent 0.0625rem),
          linear-gradient(
            90deg,
            var(--blue-100) 0.0625rem,
            transparent 0.0625rem
          );
        background-size: 1.25rem 1.25rem;
      }
    }

    .insights_cover_word {
      position: absolute;
      left: var(--space-6);
      bottom: var(--space-4);
      font-family: var(--heading-family);
      font-size: clamp(5rem, 10vw, 9rem);
      font-weight: var(--heading-bold);
      line-height: 0.8;
      letter-spacing: var(--letter-spacing-tight);
      color: rgb(255 255 255 / 0.92);
    }

    .insights_body {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-5);
      .is-featured > & {
        padding: var(--space-6);
      }
    }

    .insights_meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.35rem 0.75rem;
      font-size: 0.75rem;
      color: var(--text-2);
    }

    .insights_category {
      padding: 0.2rem 0.6rem;
      border-radius: var(--radius-round);
      background-color: var(--accent-soft);
      color: var(--accent-text);
      font-weight: var(--primary-medium);
    }

    .insights_soon {
      align-self: flex-start;
      margin-top: auto;
      font-family: var(--heading-family);
      font-size: 0.75rem;
      font-weight: var(--heading-medium);
      color: var(--text-2);
    }
  }
</style>
