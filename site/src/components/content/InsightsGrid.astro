---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import PhotoTile from "@/components/item/PhotoTile.astro";
import { tbc } from "@/data/site.ts";
import { INSIGHT_PHOTOS } from "@/data/photos.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const filters = [
  "All",
  "AI",
  "Data",
  "SAP",
  "Digital Engineering",
  "Enterprise Technology",
];

const articles = [
  {
    category: "AI",
    type: "Perspective",
    title:
      "Why most AI pilots stall, and what the ones in production did differently",
    summary:
      "The gap between demo and daily use is rarely the model. It is data, ownership and how the work is run.",
    featured: true,
  },
  {
    category: "Data",
    type: "Guide",
    title: "AI-ready data starts long before the model",
    summary:
      "What a data product needs in place before it can feed an AI use case.",
  },
  {
    category: "SAP",
    type: "Explainer",
    title: "Clean core, explained for the people who fund it",
    summary:
      "What an upgrade-ready SAP S/4HANA core means for cost, risk and speed.",
  },
  {
    category: "Enterprise Technology",
    type: "Field notes",
    title: "Two cities, one team: how a platform runs around the clock",
    summary:
      "Handoffs, overlap hours and the habits that keep a two-city team working as one.",
  },
  {
    category: "Digital Engineering",
    type: "Field notes",
    title: "Modernizing a legacy application without freezing the roadmap",
    summary: "How to keep shipping while the platform underneath is rebuilt.",
  },
];

const slug = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

{
  render && (
    <div class="insights_wrap" data-insights>
      <div class="insights_head">
        <div class="insights_intro">
          <Eyebrow data-reveal>Insights</Eyebrow>
          <Heading maxWidth={20} data-reveal style="--reveal-order: 1">
            Ideas shaping technology, data and AI.
          </Heading>
          <Paragraph
            variant="large"
            maxWidth={46}
            data-reveal
            style="--reveal-order: 2"
          >
            Field notes from the teams building and running enterprise
            platforms.
          </Paragraph>
        </div>
        <div
          class="insights_filters"
          role="group"
          aria-label="Filter insights"
          data-reveal
          style="--reveal-order: 3"
        >
          {filters.map((filter, index) => (
            <button
              class="insights_filter"
              type="button"
              aria-pressed={index === 0 ? "true" : "false"}
              data-filter={filter === "All" ? "all" : slug(filter)}
            >
              {filter}
            </button>
          ))}
        </div>
      </div>

      <div class="insights_grid">
        {articles.map((article, index) => (
          <article
            class:list={["insights_item", article.featured && "is-featured"]}
            data-category={slug(article.category)}
            data-reveal
            style={`--reveal-order: ${index % 3}`}
          >
            <PhotoTile photo={INSIGHT_PHOTOS[index]} class="insights_tile">
              {/* Small tiles keep just the category so the line never wraps. */}
              <span class="photo-tile_eyebrow insights_meta" slot="top">
                <span>{article.category}</span>
                {article.featured && (
                  <Fragment>
                    <span>{article.type}</span>
                    <span set:html={tbc("[X] min read")} />
                  </Fragment>
                )}
              </span>
              <h3
                class:list={[
                  "photo-tile_title",
                  article.featured ? "is-large" : "is-small",
                ]}
              >
                {article.title}
              </h3>
              <Fragment slot="reveal">
                <p class="photo-tile_text">{article.summary}</p>
                <span class="insights_soon">Coming soon</span>
              </Fragment>
            </PhotoTile>
          </article>
        ))}
      </div>
    </div>
  )
}

<script>
  for (const block of document.querySelectorAll<HTMLElement>(
    "[data-insights]",
  )) {
    const buttons = [
      ...block.querySelectorAll<HTMLButtonElement>("[data-filter]"),
    ];
    const cards = [...block.querySelectorAll<HTMLElement>("[data-category]")];
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter;
        buttons.forEach((b) =>
          b.setAttribute("aria-pressed", String(b === button)),
        );
        for (const card of cards) {
          const show = filter === "all" || card.dataset.category === filter;
          card.classList.toggle("is-filtered", !show);
          card.hidden = !show;
        }
        block.classList.toggle("is-filtering", filter !== "all");
      });
    }
  }
</script>

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.insights_wrap) :where(.heading, .text) {
      margin-block: 0;
    }
    .insights_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    .insights_head {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6) var(--section-space-small);
      align-items: end;
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      }
    }

    .insights_intro {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .insights_filters {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      @media (width >= 64rem) {
        justify-content: flex-end;
      }
    }

    .insights_filter {
      padding: 0.5rem 1rem;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-round);
      background-color: var(--background-2);
      font-family: var(--heading-family);
      font-size: 0.8rem;
      font-weight: var(--heading-medium);
      color: var(--text-body);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          border-color: var(--text);
          color: var(--text);
        }
      }
      &[aria-pressed="true"] {
        background-color: var(--text);
        border-color: var(--text);
        color: var(--background);
      }
    }

    /* Photo tiles; the featured story takes a 2 × 2 block on desktop. */
    .insights_grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: 17rem;
      gap: var(--site-gutter);
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-auto-rows: 16rem;
      }
      @media (width >= 64rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        .insights_wrap:not(.is-filtering) & .is-featured {
          grid-column: span 2;
          grid-row: span 2;
        }
      }
    }

    .insights_item[hidden] {
      display: none;
    }

    .insights_tile {
      height: 100%;
      min-height: 0;
    }

    .insights_meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0.75rem;
      & > span + span::before {
        content: "·";
        margin-right: 0.75rem;
        color: rgb(255 255 255 / 0.5);
      }
    }

    .insights_soon {
      margin-top: var(--space-1);
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-round);
      background-color: rgb(255 255 255 / 0.14);
      font-size: 0.75rem;
      font-weight: var(--primary-medium);
    }
  }
</style>
