---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/media/Icon.astro";
import PhotoTile from "@/components/item/PhotoTile.astro";
import arrow from "@/assets/icons/ui-arrow.svg";
import { INDUSTRIES, industryHref } from "@/data/site.ts";
import { INDUSTRY_PHOTOS } from "@/data/photos.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <div class="industry-cards_wrap">
      <div class="industry-cards_head">
        <div class="industry-cards_intro">
          <Eyebrow data-reveal>Industries</Eyebrow>
          <Heading maxWidth={20} data-reveal style="--reveal-order: 1">
            Talent that already knows your industry.
          </Heading>
        </div>
        <div class="industry-cards_aside" data-reveal style="--reveal-order: 2">
          <Button element="link" href="/industries" emphasis="secondary">
            Explore Industries
          </Button>
        </div>
      </div>

      <ul class="industry-cards_list">
        {INDUSTRIES.map((industry, index) => (
          <li
            class="industry-cards_item"
            id={industry.id}
            data-reveal
            style={`--reveal-order: ${index}`}
          >
            <PhotoTile
              href={industryHref(industry)}
              photo={INDUSTRY_PHOTOS[industry.id]}
              class="industry-cards_tile"
            >
              <span class="photo-tile_eyebrow" slot="top">
                0{index + 1}
              </span>
              <h3 class="photo-tile_title is-small">{industry.title}</h3>
              <Fragment slot="reveal">
                <p class="photo-tile_text">{industry.summary}</p>
                <span class="photo-tile_more">
                  Learn more
                  <Icon src={arrow} variant="small" />
                </span>
              </Fragment>
            </PhotoTile>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.industry-cards_wrap) :where(.heading, .text) {
      margin-block: 0;
    }

    .industry-cards_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    .industry-cards_head {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5) var(--section-space-small);
      align-items: end;
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      }
    }

    .industry-cards_intro,
    .industry-cards_aside {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }

    /* The button alone closes the row at the right edge on desktop. */
    .industry-cards_aside {
      @media (width >= 64rem) {
        align-items: flex-end;
      }
    }

    /* Portrait photo tiles: two across, four from 80rem. */
    .industry-cards_list {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--site-gutter);
      @media (width >= 30rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      @media (width >= 80rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    .industry-cards_item {
      scroll-margin-top: calc(var(--nav-height) + var(--space-5));
    }

    .industry-cards_tile {
      aspect-ratio: 3 / 4;
      @media (30rem <= width < 80rem) {
        aspect-ratio: 4 / 3;
      }
    }
  }
</style>
