---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/ui-arrow.svg";
import close from "@/assets/icons/close.svg";
import check from "@/assets/icons/check.svg";
import { CAPABILITIES, CTA } from "@/data/site.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const ways = [
  {
    title: "Dedicated capability",
    text: "Your own Data, SAP and AI engineering hub, run by ManyaIT as part of your organization.",
  },
  {
    title: "Outcome-based programs",
    text: "A defined scope, timeline and result, from a data platform to a new application.",
  },
  {
    title: "Build & Transition",
    text: "We build and run the capability, then transition it to you when you're ready to own it.",
  },
];
---

{
  render && (
    <div class="bento_wrap">
      <div class="bento_head">
        <div class="bento_intro">
          <Eyebrow data-reveal>What we build</Eyebrow>
          <Heading maxWidth={20} data-reveal style="--reveal-order: 1">
            Capabilities that move your enterprise forward
          </Heading>
        </div>
        <div class="bento_aside" data-reveal style="--reveal-order: 2">
          <Paragraph variant="large" maxWidth={46}>
            Data, SAP, AI and Digital Engineering capabilities, built and run as
            an extension of your enterprise.
          </Paragraph>
          <Paragraph maxWidth={52}>
            We build, run and scale the platforms that help enterprises decide
            faster, modernize their core systems and put AI to work.
          </Paragraph>
        </div>
      </div>

      <div class="bento_grid">
        {CAPABILITIES.map((cap, index) => (
          <article
            class:list={["bento_tile", index === 0 && "is-anchor"]}
            id={cap.id}
            data-reveal
            style={`--reveal-order: ${index % 3}`}
          >
            <div class="bento_tile_top">
              <span class="bento_icon">
                <Icon src={cap.icon} />
              </span>
              <Heading
                tag="h3"
                variant={index === 0 ? "h4" : "h5"}
                class="bento_title"
              >
                {cap.title}
              </Heading>
              <p class="bento_line">{cap.line}</p>
            </div>

            <Paragraph variant="small" class="bento_text">
              {cap.description}
            </Paragraph>
            <ul class="bento_tags">
              {cap.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            {index === 0 && (
              <div class="bento_flow" aria-hidden="true">
                <div class="bento_flow_col">
                  <span>ERP</span>
                  <span>CRM</span>
                  <span>IoT</span>
                  <span>Files</span>
                </div>
                <div class="bento_flow_link">
                  <i />
                  <i />
                  <i />
                </div>
                <div class="bento_flow_col is-core">
                  <span>Lakehouse</span>
                  <span>Data products</span>
                </div>
                <div class="bento_flow_link">
                  <i />
                  <i />
                </div>
                <div class="bento_flow_col is-out">
                  <span>Dashboards</span>
                  <span>AI</span>
                </div>
              </div>
            )}

            <button
              class="bento_more"
              type="button"
              data-dialog-open={`dialog-${cap.id}`}
              aria-haspopup="dialog"
            >
              Explore {cap.title}
              <Icon src={arrow} variant="small" />
            </button>
          </article>
        ))}

        <article class="bento_tile is-ways" data-reveal>
          <Heading tag="h3" variant="h5">
            Ways to work with us
          </Heading>
          <ol class="bento_ways">
            {ways.map((way, index) => (
              <li>
                <span class="bento_ways_index">0{index + 1}</span>
                <span class="bento_ways_title">{way.title}</span>
                <span class="bento_ways_text">{way.text}</span>
              </li>
            ))}
          </ol>
        </article>

        <article
          class="bento_tile is-cta theme-brand"
          data-reveal
          style="--reveal-order: 1"
        >
          <Heading tag="h3" variant="h4">
            Not sure where to start?
          </Heading>
          <Paragraph>
            Tell us what you want to build. We'll map the first step with you.
          </Paragraph>
          <Button
            element="link"
            href={CTA.primary.href}
            class="bento_cta_button"
          >
            {CTA.primary.label}
            <Icon src={arrow} variant="small" class="button_icon" />
          </Button>
          <svg class="bento_cta_mark" viewBox="0 0 190 120" aria-hidden="true">
            <path d="M0 0 161 119.5H135L24 37.6v58.9L0 119.5Z" />
            <path d="M189.5 0v119.5H167V36l-57.6 34.7-13.7-9.7Z" />
          </svg>
        </article>
      </div>

      {CAPABILITIES.map((cap) => (
        <dialog
          class="cap-dialog_wrap"
          id={`dialog-${cap.id}`}
          aria-labelledby={`dialog-${cap.id}-title`}
        >
          <div class="cap-dialog_inner">
            <div class="cap-dialog_top">
              <span class="bento_icon">
                <Icon src={cap.icon} />
              </span>
              <Eyebrow>{cap.title}</Eyebrow>
              <button
                class="cap-dialog_close"
                type="button"
                data-dialog-close
                aria-label="Close"
              >
                <Icon src={close} variant="small" />
              </button>
            </div>
            <Heading tag="h2" variant="h3" id={`dialog-${cap.id}-title`}>
              {cap.headline}
            </Heading>
            <Paragraph variant="large">{cap.description}</Paragraph>
            <div class="cap-dialog_cols">
              <div>
                <p class="cap-dialog_label">What we deliver</p>
                <ul class="cap-dialog_list">
                  {cap.deliver.map((item) => (
                    <li>
                      <Icon src={check} variant="small" />
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="cap-dialog_label">Outcomes you can expect</p>
                <ul class="cap-dialog_list is-outcomes">
                  {cap.outcomes.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </div>
            <div class="cap-dialog_actions">
              <Button
                element="link"
                href={`${CTA.primary.href}?topic=${cap.id}`}
              >
                {CTA.primary.label}
                <Icon src={arrow} variant="small" class="button_icon" />
              </Button>
              <Button emphasis="secondary" data-dialog-close>
                Back to capabilities
              </Button>
            </div>
          </div>
        </dialog>
      ))}
    </div>
  )
}

<script>
  /* Native dialogs give focus trapping, Escape and the backdrop for free. */
  for (const opener of document.querySelectorAll<HTMLButtonElement>(
    "[data-dialog-open]",
  )) {
    const dialog = document.getElementById(opener.dataset.dialogOpen ?? "");
    if (!(dialog instanceof HTMLDialogElement)) continue;
    opener.addEventListener("click", () => {
      dialog.showModal();
      document.documentElement.classList.add("dialog-open");
    });
    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("dialog-open");
      opener.focus();
    });
    dialog.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.closest("[data-dialog-close]"))
        dialog.close();
    });
  }
</script>

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.bento_wrap, .cap-dialog_wrap) :where(.heading, .text) {
      margin-block: 0;
    }
    .bento_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    .bento_head {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5) var(--section-space-small);
      align-items: end;
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      }
    }

    .bento_intro,
    .bento_aside {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .bento_grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--site-gutter);
      grid-template-areas: "a" "b" "c" "d" "e" "w" "z";
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-areas:
          "a a"
          "b c"
          "d e"
          "w w"
          "z z";
      }
      @media (width >= 64rem) {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        grid-template-areas:
          "a a a a a a b b b c c c"
          "a a a a a a d d d e e e"
          "w w w w w w w w z z z z";
      }
      & > :nth-child(1) {
        grid-area: a;
      }
      & > :nth-child(2) {
        grid-area: b;
      }
      & > :nth-child(3) {
        grid-area: c;
      }
      & > :nth-child(4) {
        grid-area: d;
      }
      & > :nth-child(5) {
        grid-area: e;
      }
      & > :nth-child(6) {
        grid-area: w;
      }
      & > :nth-child(7) {
        grid-area: z;
      }
    }

    .bento_tile {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-5);
      background-color: var(--background-2);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      overflow: clip;
      scroll-margin-top: calc(var(--nav-height) + var(--space-5));
      transition:
        border-color var(--hover-duration) var(--hover-ease),
        box-shadow 400ms var(--reveal-ease),
        translate 400ms var(--reveal-ease);
      @media (hover: hover) {
        &:not(.is-ways, .is-cta):hover {
          border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
          box-shadow: var(--shadow-float);
          translate: 0 -0.25rem;
          .bento_icon {
            background-color: var(--accent);
            color: var(--white);
          }
          .bento_more .icon {
            translate: 0.25rem 0;
          }
        }
      }
      &:target {
        border-color: var(--accent);
        box-shadow: 0 0 0 0.25rem var(--accent-soft);
      }
      &.is-anchor {
        padding: var(--space-6);
        background-image: radial-gradient(
          circle at 100% 0%,
          var(--blue-50),
          transparent 60%
        );
      }
    }

    .bento_tile_top {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .bento_icon {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      margin-bottom: var(--space-2);
      border-radius: var(--radius-medium);
      background-color: var(--accent-soft);
      color: var(--accent-text);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
    }

    .bento_line {
      font-family: var(--heading-family);
      font-size: var(--text-main);
      font-weight: var(--heading-medium);
      color: var(--accent);
    }

    .bento_text {
      max-width: 52ch;
    }

    .bento_tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      & li {
        padding: 0.3rem 0.7rem;
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-round);
        font-size: 0.75rem;
        color: var(--text-body);
      }
    }

    .bento_more {
      display: inline-flex;
      align-items: center;
      align-self: flex-start;
      gap: 0.5em;
      text-align: left;
      margin-top: auto;
      padding-top: var(--space-2);
      font-family: var(--heading-family);
      font-size: var(--text-small);
      font-weight: var(--heading-medium);
      color: var(--link-text);
      & .icon {
        transition: translate var(--hover-duration) var(--hover-ease);
      }
      &::after {
        content: "";
        position: absolute;
        inset: 0;
      }
    }

    /* Anchor tile: data flowing from sources to decisions. */
    .bento_flow {
      flex: 1;
      align-content: center;
      display: grid;
      grid-template-columns: auto 1fr auto 1fr auto;
      align-items: center;
      gap: var(--space-2);
      margin-block: var(--space-4);
      padding: var(--space-5) var(--space-4);
      border: var(--border-width) dashed var(--border);
      border-radius: var(--radius-medium);
      background-color: color-mix(
        in srgb,
        var(--background-2) 70%,
        transparent
      );
      font-size: 0.72rem;
    }

    @media (width < 30rem) {
      .bento_flow {
        padding-inline: var(--space-2);
        gap: 0.3rem;
        font-size: 0.64rem;
        .bento_flow_col span {
          padding-inline: 0.35rem;
          white-space: normal;
        }
        .bento_flow_link {
          min-width: 0.75rem;
        }
      }
    }

    .bento_flow_col {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      & span {
        padding: 0.3rem 0.6rem;
        border-radius: var(--radius-small);
        background-color: var(--background-3);
        color: var(--text-body);
        text-align: center;
        white-space: nowrap;
      }
      &.is-core span {
        background-color: var(--accent);
        color: var(--white);
        padding-block: 0.55rem;
        font-weight: var(--primary-medium);
      }
      &.is-out span {
        background-color: var(--accent-soft);
        color: var(--accent-text);
      }
    }

    .bento_flow_link {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.9rem;
      min-width: 1.5rem;
      & i {
        position: relative;
        display: block;
        height: var(--border-width);
        background-color: var(--border);
        overflow: visible;
        &::after {
          content: "";
          position: absolute;
          top: -0.15rem;
          left: 0;
          width: 0.35rem;
          height: 0.35rem;
          border-radius: 50%;
          background-color: var(--accent);
          animation: bento-flow 2.4s var(--hover-ease) infinite;
        }
        &:nth-child(2)::after {
          animation-delay: 0.8s;
        }
        &:nth-child(3)::after {
          animation-delay: 1.6s;
        }
      }
    }

    @keyframes bento-flow {
      0% {
        left: 0;
        opacity: 0;
      }
      15%,
      85% {
        opacity: 1;
      }
      100% {
        left: calc(100% - 0.35rem);
        opacity: 0;
      }
    }

    .is-ways {
      gap: var(--space-5);
    }

    .bento_ways {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
      @media (width >= 48rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      & li {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding-top: var(--space-4);
        border-top: var(--border-width) solid var(--border);
      }
    }

    .bento_ways_index {
      font-family: var(--heading-family);
      font-size: 0.72rem;
      font-weight: var(--heading-bold);
      color: var(--accent);
    }

    .bento_ways_title {
      font-family: var(--heading-family);
      font-weight: var(--heading-bold);
      color: var(--text);
    }

    .bento_ways_text {
      font-size: var(--text-small);
      color: var(--text-body);
    }

    .is-cta {
      justify-content: flex-end;
      min-height: 17rem;
      border-color: transparent;
      & .text {
        max-width: 30ch;
      }
    }

    .bento_cta_button {
      align-self: flex-start;
      margin-top: var(--space-2);
    }

    .bento_cta_mark {
      position: absolute;
      top: var(--space-5);
      right: var(--space-5);
      width: 5.5rem;
      fill: color-mix(in srgb, var(--white) 18%, transparent);
      transition: translate 600ms var(--reveal-ease);
      .is-cta:hover & {
        translate: 0 -0.25rem;
      }
    }

    /* Capability detail */
    .cap-dialog_wrap {
      width: min(52rem, calc(100% - var(--site-margin) * 2));
      max-height: min(90svh, 56rem);
      margin: auto;
      padding: 0;
      border: 0;
      border-radius: var(--radius-main);
      background-color: var(--background-2);
      color: var(--text);
      box-shadow: var(--shadow-float);
      opacity: 0;
      translate: 0 1.5rem;
      transition:
        opacity 300ms var(--hover-ease),
        translate 500ms var(--reveal-ease),
        overlay 300ms allow-discrete,
        display 300ms allow-discrete;
      &[open] {
        opacity: 1;
        translate: 0 0;
        @starting-style {
          opacity: 0;
          translate: 0 1.5rem;
        }
      }
      &::backdrop {
        background-color: rgb(13 15 13 / 0);
        backdrop-filter: blur(0);
        transition:
          background-color 300ms var(--hover-ease),
          backdrop-filter 300ms var(--hover-ease),
          overlay 300ms allow-discrete,
          display 300ms allow-discrete;
      }
      &[open]::backdrop {
        background-color: rgb(13 15 13 / 0.45);
        backdrop-filter: blur(0.25rem);
        @starting-style {
          background-color: rgb(13 15 13 / 0);
          backdrop-filter: blur(0);
        }
      }
    }

    .dialog-open {
      overflow: hidden;
    }

    .cap-dialog_inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      padding: var(--space-7) var(--space-6);
    }

    .cap-dialog_top {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      & .bento_icon {
        margin: 0;
      }
    }

    .cap-dialog_close {
      margin-left: auto;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border: var(--border-width) solid var(--border);
      border-radius: 50%;
      color: var(--text);
      transition: background-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          background-color: var(--background-3);
        }
      }
    }

    .cap-dialog_cols {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
      padding-top: var(--space-5);
      border-top: var(--border-width) solid var(--divider);
      @media (width >= 48rem) {
        grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      }
    }

    .cap-dialog_label {
      margin-bottom: var(--space-3);
      font-family: var(--heading-family);
      font-size: 0.75rem;
      font-weight: var(--heading-bold);
      letter-spacing: var(--letter-spacing-wide);
      text-transform: uppercase;
      color: var(--text-2);
    }

    .cap-dialog_list {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      font-size: var(--text-small);
      color: var(--text-body);
      & li {
        display: flex;
        gap: 0.6rem;
      }
      & .icon {
        margin-top: 0.3em;
        color: var(--accent);
      }
      &.is-outcomes li {
        padding: var(--space-3);
        border-radius: var(--radius-small);
        background-color: var(--background-3);
        color: var(--text);
      }
    }

    .cap-dialog_actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      padding-top: var(--space-2);
    }
  }
</style>
