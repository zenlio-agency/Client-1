---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/media/Icon.astro";
import PhotoTile from "@/components/item/PhotoTile.astro";
import arrow from "@/assets/icons/ui-arrow.svg";
import { CAPABILITIES, CTA, capabilityHref } from "@/data/site.ts";
import { CAPABILITY_PHOTOS } from "@/data/photos.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <div class="bento_wrap">
      <div class="bento_head">
        <div class="bento_intro">
          <Eyebrow data-reveal>Capabilities</Eyebrow>
          <Heading maxWidth={20} data-reveal style="--reveal-order: 1">
            Expertise across the modern enterprise stack
          </Heading>
        </div>
        <Paragraph
          variant="large"
          maxWidth={44}
          data-reveal
          style="--reveal-order: 2"
        >
          Platform-specialist capability across data, AI, SAP and product
          engineering, integrated into your roadmap and governed for enterprise
          scale.
        </Paragraph>
      </div>

      <div class="bento_grid">
        {CAPABILITIES.map((cap, index) => (
          <PhotoTile
            href={capabilityHref(cap)}
            photo={CAPABILITY_PHOTOS[cap.id]}
            class={`bento_tile is-${cap.id}`}
            id={cap.id}
            data-reveal
            style={`--reveal-order: ${index % 3}`}
          >
            <span class="photo-tile_icon" slot="top">
              <Icon src={cap.icon} variant="small" />
            </span>
            <h3 class:list={["photo-tile_title", index === 0 && "is-large"]}>
              {cap.title}
            </h3>
            <Fragment slot="reveal">
              <p class="photo-tile_text">{cap.line}</p>
              <span class="photo-tile_more">
                Explore
                <Icon src={arrow} variant="small" />
              </span>
            </Fragment>
          </PhotoTile>
        ))}

        <PhotoTile
          tone="brand"
          class="bento_tile is-cta"
          data-reveal
          style="--reveal-order: 2"
        >
          <h3 class="photo-tile_title is-large">Unlock your data.</h3>
          <p class="photo-tile_text bento_cta_text">
            Tell us your platforms and goals. We'll engineer the data and AI
            behind them, end to end.
          </p>
          <Button element="link" href={CTA.primary.href} emphasis="secondary">
            {CTA.primary.label}
            <Icon src={arrow} variant="small" class="button_icon" />
          </Button>
        </PhotoTile>
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.bento_wrap) :where(.heading, .text) {
      margin-block: 0;
    }
    .bento_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    .bento_head {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5) var(--section-space-small);
      align-items: end;
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      }
    }

    .bento_intro {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    /* Photo mosaic: Data leads as a large square, the rest fill around it. */
    .bento_grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: 17rem;
      gap: var(--site-gutter);
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-auto-rows: 15rem;
        grid-template-areas:
          "data data"
          "sap ai"
          "flow code"
          "cta cta";
      }
      @media (width >= 64rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        grid-template-areas:
          "data data sap sap"
          "data data ai flow"
          "code code cta cta";
      }
      /* Areas only exist from 48rem; on phones the tiles simply stack. */
      @media (width >= 48rem) {
        & > .is-cap-data {
          grid-area: data;
        }
        & > .is-cap-sap {
          grid-area: sap;
        }
        & > .is-cap-ai {
          grid-area: ai;
        }
        & > .is-cap-flow {
          grid-area: flow;
        }
        & > .is-cap-code {
          grid-area: code;
        }
        & > .is-cta {
          grid-area: cta;
        }
      }
    }

    .bento_tile {
      min-height: 0;
      scroll-margin-top: calc(var(--nav-height) + var(--space-5));
    }

    .bento_cta_text {
      margin-bottom: var(--space-2);
      font-size: var(--text-main);
    }
  }
</style>
