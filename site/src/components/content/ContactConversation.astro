---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/media/Icon.astro";
import Form from "@/components/form/Form.astro";
import Input from "@/components/form/Input.astro";
import Select from "@/components/form/Select.astro";
import Textarea from "@/components/form/Textarea.astro";
import Fieldset from "@/components/form/Fieldset.astro";
import Choice from "@/components/form/Choice.astro";
import SocialLinks from "@/components/global/SocialLinks.astro";
import arrow from "@/assets/icons/ui-arrow.svg";
import {
  CAPABILITIES,
  INDUSTRIES,
  CTA,
  HUBS,
  COMPANY_CONTACT,
  tbc,
} from "@/data/site.ts";
import { LEGAL } from "@/data/legal.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Heading level for the section heading. Use `h2` below a page's own h1. */
  headingTag?: "h1" | "h2";
}

const { render = true, headingTag = "h1" } = Astro.props;
const cardTag = headingTag === "h1" ? "h2" : "h3";

const areas = [
  ...CAPABILITIES.map((cap) => ({ value: cap.id, label: cap.title })),
  { value: "capability-center", label: "A full capability center" },
];

const roles = [
  { value: "enterprise", label: "An enterprise planning a team" },
  { value: "client", label: "An existing ManyaIT client" },
  { value: "partner", label: "A technology or alliance partner" },
  { value: "careers", label: "An engineer or specialist exploring careers" },
  { value: "media", label: "Media or an analyst" },
  { value: "other", label: "Something else" },
];

const industries = [
  ...INDUSTRIES.map((industry) => ({
    value: industry.id,
    label: industry.title,
  })),
  { value: "other", label: "Another industry" },
];

/* What happens after a brief arrives, one word a step. */
const next = ["Discovery", "Alignment", "Roadmap"];

/* Ways to reach the company without the form, shown beside it. */
const direct = [
  {
    label: "Email",
    value: COMPANY_CONTACT.email,
    href: `mailto:${COMPANY_CONTACT.email}`,
  },
  {
    label: "Careers",
    value: COMPANY_CONTACT.careersEmail,
    href: `mailto:${COMPANY_CONTACT.careersEmail}`,
  },
  {
    label: "Call",
    value: COMPANY_CONTACT.phone,
    href: `tel:${COMPANY_CONTACT.phone.replace(/[^+\d]/g, "")}`,
  },
];
---

{
  render && (
    <div class="contact_wrap" data-contact>
      <div class="contact_intro">
        <Eyebrow data-reveal>Start a conversation</Eyebrow>
        <Heading
          tag={headingTag}
          variant={headingTag}
          maxWidth={16}
          data-reveal
          style="--reveal-order: 1"
        >
          Tell us what you want to build.
        </Heading>
        <Paragraph
          variant="large"
          maxWidth={44}
          data-reveal
          style="--reveal-order: 2"
        >
          <Fragment
            set:html={tbc(
              "Brief us on your goals and we'll match you with the right team. Expect a reply within [1] business day.",
            )}
          />
        </Paragraph>
        <ol class="contact_next" data-reveal style="--reveal-order: 3">
          {next.map((step, index) => (
            <li>
              <span class="contact_next_index">0{index + 1}</span>
              <span class="contact_next_text">{step}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="contact_card" data-reveal style="--reveal-order: 2">
        <Heading tag={cardTag} variant="h4" class="contact_card_title">
          How can we help you?
        </Heading>
        <Form
          name="start-a-conversation"
          successMessage="Thanks. This preview form isn't connected to an inbox yet, so nothing was sent. Once ManyaIT's inbox is connected, this is where your note will go."
        >
          <div class="contact_grid">
            <Input
              label="Full name"
              name="name"
              autocomplete="name"
              placeholder="Your name"
              required
            />
            <Input
              label="Business email"
              variant="email"
              name="email"
              placeholder="name@company.com"
              required
            />
            <Input
              label="Company name"
              name="company"
              autocomplete="organization"
              placeholder="Company"
              required
            />
            <Input
              label="Job title"
              name="title"
              autocomplete="organization-title"
              placeholder="Your role"
              required
            />
            <Select
              label="Which best describes you?"
              name="role"
              options={roles}
              placeholder="Choose one"
              data-role
            />
            <Select
              label="Industry"
              name="industry"
              options={industries}
              placeholder="Choose an industry"
              data-industry
            />
            <Fieldset
              legend="What would you like to build?"
              legendStyle="label"
              class="contact_areas"
              data-areas
            >
              <p class="contact_hint text-style-small">
                Choose as many as needed.
              </p>
              {areas.map((area) => (
                <Choice label={area.label} name="areas" value={area.value} />
              ))}
            </Fieldset>
            <Textarea
              label="Tell us more about your goals"
              name="message"
              placeholder="The team you need, the systems involved and any timelines"
              minLines={9}
              required
            />
          </div>
          {/* The request and marketing are separate choices, and the
              marketing box is never ticked for you. */}
          <div class="contact_consent">
            <Choice
              label="I agree to ManyaIT contacting me about this request."
              name="consent"
              value="yes"
              required
            />
            <Choice
              label="Also send me occasional ManyaIT news and insights by email."
              name="marketing"
              value="yes"
            />
          </div>
          <div class="contact_submit">
            <Button type="submit">
              {CTA.primary.label}
              <Icon src={arrow} variant="small" class="button_icon" />
            </Button>
            <p class="contact_notice text-style-small" data-notice="general">
              We use your details to reply to your message. See our{" "}
              <a href="/legal/privacy">Privacy Notice</a>.
            </p>
            <p
              class="contact_notice text-style-small"
              data-notice="careers"
              hidden
            >
              <Fragment
                set:html={tbc(
                  `We'll keep your details for ${LEGAL.talentRetention} to match you with roles. See our <a href="/legal/applicant-privacy">Applicant Privacy Notice</a>.`,
                )}
              />
            </p>
          </div>
        </Form>
      </div>

      <div class="contact_direct" data-reveal style="--reveal-order: 4">
        <p class="contact_direct_title">Prefer to reach us directly?</p>
        <div class="contact_direct_grid">
          <dl class="contact_direct_list">
            {direct.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>
                  <a href={item.href}>{item.value}</a>
                </dd>
              </div>
            ))}
          </dl>
          <dl class="contact_direct_list">
            {HUBS.map((hub) => (
              <div>
                <dt>
                  {hub.country} · {hub.role}
                </dt>
                <dd>
                  {hub.entity}
                  <br />
                  <a href={`tel:${hub.phone.replace(/[^+\d]/g, "")}`}>
                    {hub.phone}
                  </a>
                  {" · "}
                  <a href={`mailto:${hub.email}`}>{hub.email}</a>
                </dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="contact_direct_social">
          <span class="contact_direct_label">Follow ManyaIT</span>
          <SocialLinks />
        </div>
      </div>
    </div>
  )
}

<script>
  for (const contact of document.querySelectorAll<HTMLElement>(
    "[data-contact]",
  )) {
    /* At least one area must be ticked; the first box carries the message so
       the browser blocks the submit and points at the group. */
    const boxes = [
      ...contact.querySelectorAll<HTMLInputElement>("[data-areas] input"),
    ];
    const sync = () =>
      boxes[0]?.setCustomValidity(
        boxes.some((box) => box.checked) ? "" : "Choose at least one area.",
      );
    boxes.forEach((box) => box.addEventListener("change", sync));
    sync();

    /* People exploring careers see the applicant notice instead of the
       general one. */
    const role = contact.querySelector<HTMLSelectElement>("select[data-role]");
    const notices = [...contact.querySelectorAll<HTMLElement>("[data-notice]")];
    const syncNotice = () => {
      const kind = role?.value === "careers" ? "careers" : "general";
      for (const notice of notices) {
        notice.hidden = notice.dataset.notice !== kind;
      }
    };
    role?.addEventListener("change", syncNotice);
    syncNotice();
    contact
      .querySelector("form")
      ?.addEventListener("reset", () => requestAnimationFrame(syncNotice));

    /* Arriving from a capability, industry or careers link preselects the
       matching answer. */
    const topic = new URLSearchParams(location.search).get("topic");
    if (!topic) continue;
    const area = boxes.find((box) => box.value === topic);
    const industry = contact.querySelector<HTMLSelectElement>(
      "select[data-industry]",
    );
    if (area) {
      area.checked = true;
      sync();
    } else if (
      industry &&
      [...industry.options].some((o) => o.value === topic)
    ) {
      industry.value = topic;
    } else if (role && topic === "careers") {
      role.value = "careers";
      syncNotice();
    }
  }
</script>

<style is:global>
  @layer components {
    :where(.contact_wrap) :where(.heading, .text) {
      margin-block: 0;
    }

    /* The intro and the direct details share the left column, beside the
       form. On narrow screens the details come before the form, so email and
       phone are in reach without scrolling past it. */
    .contact_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "intro" "direct" "form";
      gap: var(--space-6) var(--section-space-small);
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
        grid-template-rows: auto 1fr;
        grid-template-areas: "intro form" "direct form";
        align-items: start;
      }
    }

    .contact_intro {
      grid-area: intro;
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }

    /* The three steps read as one line: numbered, one word each. */
    .contact_next {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3) var(--space-5);
      margin-top: var(--space-2);
      & li {
        display: flex;
        align-items: center;
        gap: var(--space-2);
      }
    }

    .contact_next_index {
      flex: none;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      place-items: center;
      width: 2rem;
      height: 2rem;
      border-radius: 50%;
      background-color: var(--accent-soft);
      color: var(--accent-text);
      font-family: var(--heading-family);
      font-size: 0.72rem;
      font-weight: var(--heading-bold);
    }

    .contact_next_text {
      font-family: var(--heading-family);
      font-size: var(--text-small);
      font-weight: var(--heading-bold);
      color: var(--text);
    }

    /* Email, phone, addresses and social profiles, for anyone who'd rather
       not use the form. */
    .contact_direct {
      grid-area: direct;
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      padding: var(--space-5) var(--space-6);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      background-color: var(--background-2);
      & p {
        margin-block: 0;
      }
    }

    .contact_direct_title {
      font-family: var(--display-family);
      font-size: var(--h6);
      font-weight: var(--heading-bold);
      color: var(--text);
    }

    .contact_direct_grid {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    /* Email, careers and phone sit in a row; the addresses run full width
       below them. */
    .contact_direct_list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
      gap: var(--space-4) var(--space-5);
      & + & {
        padding-top: var(--space-4);
        border-top: var(--border-width) solid var(--divider);
        grid-template-columns: minmax(0, 1fr);
      }
      & div {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }
      & dt {
        font-family: var(--heading-family);
        font-size: 0.72rem;
        font-weight: var(--heading-bold);
        letter-spacing: var(--letter-spacing-wide);
        text-transform: uppercase;
        color: var(--text-2);
      }
      & dd {
        font-size: var(--text-small);
        line-height: 1.55;
        color: var(--text-body);
      }
      & a {
        color: var(--link-text);
        text-decoration: none;
        @media (hover: hover) {
          &:hover {
            text-decoration: underline;
            text-underline-offset: 0.2em;
          }
        }
      }
    }

    .contact_direct_social {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      padding-top: var(--space-4);
      border-top: var(--border-width) solid var(--divider);
    }

    .contact_direct_label {
      font-family: var(--heading-family);
      font-size: 0.72rem;
      font-weight: var(--heading-bold);
      letter-spacing: var(--letter-spacing-wide);
      text-transform: uppercase;
      color: var(--text-2);
    }

    .contact_card {
      grid-area: form;
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      padding: var(--space-6);
      border-radius: var(--radius-main);
      background-color: var(--background-2);
      border: var(--border-width) solid var(--border);
      box-shadow: var(--shadow-raised);
      @media (width >= 48rem) {
        padding: var(--space-7) var(--space-6);
      }
      & .form_fields {
        row-gap: var(--space-5);
      }
    }

    .contact_card_title {
      margin-block: 0;
    }

    /* Fields pair up two to a row, the areas sitting beside the message. */
    .contact_grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
      align-items: start;
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    .contact_areas .form-fieldset_fields {
      gap: var(--space-2);
    }

    /* On the white card, boxes match the text fields and tick in Manya
       Blue. */
    .contact_card .form-choice_mark {
      --_mark: var(--background);
      --_mark-hover: var(--accent-soft);
      --_mark-chosen: var(--accent);
      --_ink: var(--white);
      border-color: var(--border);
    }

    .contact_hint {
      color: var(--text-2);
    }

    .contact_consent {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding-top: var(--space-4);
      border-top: var(--border-width) solid var(--divider);
    }

    .contact_notice {
      margin-block: 0;
      color: var(--text-2);
      &[hidden] {
        display: none;
      }
      & a {
        color: var(--link-text);
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
    }

    .contact_submit {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
