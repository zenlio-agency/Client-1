---
import Heading from "@/components/typography/Heading.astro";
import Button from "@/components/Button.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const rows = [
  [
    [
      "Our data lives in twelve systems and agrees in none.",
      "Data & Analytics",
      "cap-data",
    ],
    ["Our AI pilots never reach production.", "Applied AI", "cap-ai"],
    [
      "We need a team that stays, not one that rotates.",
      "Dedicated capability",
      "why",
    ],
    [
      "Audit wants to know exactly what the automation did.",
      "Autonomous AI Workflows",
      "cap-flow",
    ],
  ],
  [
    ["The S/4HANA move keeps slipping.", "SAP & Enterprise Data", "cap-sap"],
    [
      "Our teams spend the day on copy-and-paste work.",
      "Autonomous AI Workflows",
      "cap-flow",
    ],
    [
      "Support stops when one time zone logs off.",
      "Two cities, one team",
      "locations",
    ],
  ],
  [
    [
      "Every release waits on the legacy platform.",
      "Digital Product Engineering",
      "cap-code",
    ],
    ["Our ERP data isn't ready for AI.", "SAP & Enterprise Data", "cap-sap"],
    [
      "We need to grow the team without starting over.",
      "Scale with confidence",
      "how",
    ],
  ],
];
---

{
  render && (
    <div class="challenge-rows_wrap" data-challenges>
      <div class="challenge-rows_head">
        <Heading class="heading-accent" maxWidth={24} data-reveal>
          Every enterprise hits these walls.{" "}
          <strong>We build the way through.</strong>
        </Heading>
        <Button
          variant="play"
          emphasis="secondary"
          pressed={true}
          label="Pause"
          class="challenge-rows_toggle"
          data-challenges-toggle
        />
      </div>
      <div class="challenge-rows_rows" data-reveal style="--reveal-order: 1">
        {rows.map((row, index) => (
          <div
            class:list={["challenge-rows_row", index % 2 === 1 && "is-reverse"]}
          >
            <div class="challenge-rows_track">
              {[0, 1].map((copy) => (
                <ul
                  class="challenge-rows_panel"
                  aria-hidden={copy === 1 ? "true" : undefined}
                  inert={copy === 1}
                >
                  {row.map(([quote, answer, target]) => (
                    <li>
                      <a class="challenge-rows_item" href={`/#${target}`}>
                        <span class="challenge-rows_quote">“{quote}”</span>
                        <span class="challenge-rows_answer">{answer}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  )
}

<script>
  for (const block of document.querySelectorAll<HTMLElement>(
    "[data-challenges]",
  )) {
    const toggle = block.querySelector<HTMLButtonElement>(
      "[data-challenges-toggle]",
    );
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const setPlaying = (playing: boolean) => {
      block.dataset.state = playing ? "playing" : "paused";
      toggle?.setAttribute("aria-pressed", String(playing));
      toggle?.setAttribute("aria-label", playing ? "Pause" : "Play");
    };
    setPlaying(!reduced.matches);
    toggle?.addEventListener("click", () =>
      setPlaying(block.dataset.state !== "playing"),
    );
  }
</script>

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.challenge-rows_wrap) :where(.heading, .text) {
      margin-block: 0;
    }
    .challenge-rows_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    .challenge-rows_head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-5);
    }

    .challenge-rows_toggle {
      font-size: 0.75rem;
      flex: none;
    }

    .challenge-rows_rows {
      --_gap: var(--space-3);
      width: 100vw;
      margin-inline: calc(50% - 50vw);
      display: flex;
      flex-direction: column;
      gap: var(--_gap);
      mask-image: linear-gradient(
        to right,
        transparent,
        black 8%,
        black 92%,
        transparent
      );
    }

    .challenge-rows_row {
      overflow: clip;
    }

    .challenge-rows_track {
      display: flex;
      width: max-content;
      gap: var(--_gap);
      animation: challenge-scroll 58s linear infinite;
      animation-play-state: paused;
      .is-reverse > & {
        animation-direction: reverse;
        animation-duration: 64s;
      }
      .challenge-rows_wrap[data-state="playing"] & {
        animation-play-state: running;
      }
      .challenge-rows_wrap[data-state="playing"]
        .challenge-rows_rows:is(:hover, :focus-within)
        & {
        animation-play-state: paused;
      }
    }

    @keyframes challenge-scroll {
      to {
        translate: calc(-50% - var(--_gap) / 2) 0;
      }
    }

    .challenge-rows_panel {
      display: flex;
      gap: var(--_gap);
    }

    .challenge-rows_item {
      display: inline-flex;
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-3) var(--space-3) var(--space-3) var(--space-5);
      background-color: var(--background-2);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-round);
      white-space: nowrap;
      transition:
        border-color var(--hover-duration) var(--hover-ease),
        box-shadow var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          border-color: var(--accent);
          box-shadow: var(--shadow-raised);
          .challenge-rows_answer {
            background-color: var(--accent);
            color: var(--white);
          }
        }
      }
    }

    .challenge-rows_quote {
      font-size: var(--text-main);
      color: var(--text);
    }

    .challenge-rows_answer {
      display: inline-flex;
      align-items: center;
      gap: 0.4em;
      padding: 0.35rem 0.8rem;
      border-radius: var(--radius-round);
      background-color: var(--accent-soft);
      color: var(--accent-text);
      font-family: var(--heading-family);
      font-size: 0.78rem;
      font-weight: var(--heading-medium);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
      &::before {
        content: "→";
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .challenge-rows_row {
        overflow-x: auto;
      }
    }
  }
</style>
